<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Chave do Firebase e tokens dos aparelhos: nunca servidos por URL. -->
          <add segment="segredos" />
          <add segment="dados" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
