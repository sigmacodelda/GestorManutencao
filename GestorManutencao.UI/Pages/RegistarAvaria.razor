@page "/avaria"
@inject IIntervencoesService Intervencoes
@inject IEquipamentosService Equipamentos
@inject NavigationManager Nav
@inject IGestorOffline Offline
@inject SessaoService Sessao

<PageTitle>Registar avaria · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="/"><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Registar avaria</h1>
    </div>
    @if (Sessao.Modo == ModoTrabalho.Supervisor)
    {
        <a class="btn btn-secundario" href="nova-ficha"><Icone Nome="plus" /><span>Nova ficha completa</span></a>
    }

    @if (_guardadoSemRede)
    {
        <div class="sucesso" role="status">
            <span class="sucesso-icone"><Icone Nome="circle-check" /></span>
            <p class="sucesso-titulo">Guardado.</p>
            <p class="sucesso-desc">Será enviado quando houver rede.</p>
            <a class="btn btn-primario btn-grande" href="intervencoes"><span>Ver as minhas intervenções</span></a>
        </div>
    }
    else
    {
    <form class="formulario" @onsubmit="GuardarAsync" novalidate>
        <div class="campo">
            <label for="equipamento">Equipamento</label>
            <input id="equipamento" type="search" autocomplete="off" placeholder="Escreva o nome" value="@_texto"
                   @oninput="PesquisarAsync" aria-describedby="erro-avaria" />
            @if (_escolhido is not null)
            {
                <p class="escolhido"><Icone Nome="check" /><span>@_escolhido.Nome · @_escolhido.Zona</span></p>
            }
            else if (_opcoes.Count > 0)
            {
                <ul class="opcoes" aria-label="Equipamentos encontrados">
                    @foreach (var e in _opcoes)
                    {
                        <li><button type="button" class="opcao" @onclick="() => Escolher(e)">@e.Nome <span class="opcao-zona">@e.Zona</span></button></li>
                    }
                </ul>
            }
            else if (_semResultados)
            {
                <p class="campo-erro" role="status">Não encontrei este equipamento na lista guardada neste telemóvel. Quando houver rede, tente outra vez.</p>
            }
        </div>

        <div class="campo">
            <label for="anomalia">Qual é o problema?</label>
            <textarea id="anomalia" rows="4" maxlength="@Max" @bind="_anomalia" @bind:event="oninput" aria-describedby="contador-avaria"></textarea>
            <span id="contador-avaria" class="campo-contador @(_anomalia.Length >= Max ? "no-limite" : "")" aria-live="polite">
                @(_anomalia.Length >= Max ? $"Chegou ao limite de {Max} letras." : $"{_anomalia.Length} de {Max} letras")
            </span>
            <Microfone @bind-Texto="_anomalia" MaxLength="Max" />
        </div>

        <p id="erro-avaria" class="campo-erro" role="alert">@_erro</p>

        <button type="submit" class="btn btn-primario" disabled="@_a_guardar">@(_a_guardar ? "A guardar…" : "Guardar avaria")</button>
    </form>
    }
</section>

@code {
    private string _texto = "", _anomalia = "", _erro = "";
    private IReadOnlyList<Equipamento> _opcoes = [];
    private Equipamento? _escolhido;
    private bool _a_guardar, _guardadoSemRede, _semResultados;

    // Com o identificador da operação (avaria registada sem rede) o texto tem este limite.
    private const int Max = RegrasIntervencao.MaxAnomalia;

    private CancellationTokenSource? _espera;

    [SupplyParameterFromQuery(Name = "equipamento")] public string? EquipamentoId { get; set; }

    // Vindo da ficha de um equipamento, já traz o equipamento escolhido.
    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(EquipamentoId)) return;
        try
        {
            if (await Equipamentos.ObterFichaAsync(EquipamentoId) is { } ficha) { _escolhido = ficha.Equipamento; _texto = ficha.Equipamento.Nome; }
        }
        catch (Exception) { /* escolhe-se à mão */ }
    }

    // Espera 300 ms depois da última tecla antes de ir ao servidor.
    private async Task PesquisarAsync(ChangeEventArgs e)
    {
        _texto = e.Value?.ToString() ?? "";
        _escolhido = null;
        _erro = "";
        _semResultados = false;
        _espera?.Cancel();
        _espera = new CancellationTokenSource();
        var cancelamento = _espera.Token;
        if (_texto.Length == 0) { _opcoes = []; return; }
        try
        {
            await Task.Delay(300, cancelamento);
            var texto = _texto;
            var encontrados = await Equipamentos.PesquisarAsync(texto, cancelamento);
            if (!cancelamento.IsCancellationRequested)
            {
                _opcoes = encontrados;
                _semResultados = encontrados.Count == 0 && Offline.SemLigacao && RegrasPesquisa.TextoValido(texto) && texto.Trim().Length > 0;
            }
        }
        catch (OperationCanceledException) { /* veio outra tecla */ }
        catch (NotSupportedException) { _erro = "Esta parte ainda não está disponível."; }
        catch (Exception) { _erro = "Não foi possível pesquisar. Tente outra vez."; }
    }

    private void Escolher(Equipamento e) { _espera?.Cancel(); _escolhido = e; _texto = e.Nome; _opcoes = []; _erro = ""; }

    private async Task GuardarAsync()
    {
        _erro = RegrasIntervencao.ValidarAvaria(_escolhido?.Nome, _anomalia) ?? "";
        if (_erro.Length > 0) return;

        _a_guardar = true;
        try
        {
            var ficha = await Intervencoes.RegistarAvariaAsync(_escolhido!.Id, _anomalia);
            if (ficha.Pendente) _guardadoSemRede = true;
            else Nav.NavigateTo("intervencoes");
        }
        catch (NotSupportedException) { _erro = "Esta parte ainda não está disponível."; }
        catch (Exception) { _erro = "Não foi possível guardar. Tente outra vez."; }
        finally { _a_guardar = false; }
    }
}
