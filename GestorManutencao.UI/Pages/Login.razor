@page "/login"
@layout Layout.LoginLayout
@inject SessaoService Sessao
@inject NavigationManager Nav

<PageTitle>Entrar · Gestor de Manutenção</PageTitle>

<div class="login">
    <aside class="login-marca">
        <Logo />
        <Engrenagem Classe="engr-login" />
        <div class="login-marca-texto">
            <p class="sobretitulo">Gestor de Manutenção</p>
            <p class="login-marca-frase">As intervenções do seu turno, num só sítio.</p>
        </div>
    </aside>

    <section class="login-painel" aria-labelledby="titulo-login">
        <div class="login-form" tabindex="0" @ref="_raiz" @onkeydown="AoTecla" @onkeydown:preventDefault="_travarTeclas">
            <h1 id="titulo-login">Olá! Escreva o seu PIN</h1>
            <p class="login-sub">São 6 números.</p>

            @if (_erro is not null)
            {
                <div class="alerta" role="alert" tabindex="-1" @ref="_alerta">
                    <Icone Nome="triangle-alert" />
                    <span>@_erro</span>
                </div>
            }

            <div class="pin-pontos @(_erro is not null ? "pin-pontos-erro" : "")" role="img" aria-label="@_pin.Length de @RegrasPin.Tamanho números escritos">
                @for (var n = 0; n < RegrasPin.Tamanho; n++)
                {
                    <span class="pin-ponto @(n < _pin.Length ? "cheio" : "")"></span>
                }
            </div>

            <div class="teclado" role="group" aria-label="Teclado de números">
                @foreach (var d in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9" })
                {
                    <button type="button" class="tecla" disabled="@_aEntrar" @onclick="() => AdicionarAsync(d)">@d</button>
                }
                <span></span>
                <button type="button" class="tecla" disabled="@_aEntrar" @onclick="@(() => AdicionarAsync("0"))">0</button>
                <button type="button" class="tecla tecla-apagar" disabled="@_aEntrar" aria-label="Apagar" @onclick="Apagar"><Icone Nome="delete" /></button>
            </div>

            @if (_aEntrar)
            {
                <p class="login-sub" role="status"><span class="spinner" aria-hidden="true"></span> A entrar…</p>
            }

            <p class="login-rodape">Sem acesso ou esqueceu o PIN? Fale com o seu supervisor.</p>
            <p class="login-credito">Desenvolvido por SigmaCode</p>
        </div>
    </section>
</div>

@code {
    private string _pin = "";
    private bool _aEntrar;
    private bool _travarTeclas;
    private string? _erro;
    private ElementReference _raiz, _alerta;
    private bool _focarAlerta;

    protected override async Task OnInitializedAsync()
    {
        await Sessao.RestaurarAsync();
        if (Sessao.TemSessao) Nav.NavigateTo("", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _raiz.FocusAsync();
        if (_focarAlerta && _erro is not null)
        {
            _focarAlerta = false;
            await _alerta.FocusAsync();
        }
    }

    // Teclado do ecrã ou do computador: só números; ao chegar aos 6 entra sozinho.
    private async Task AoTecla(KeyboardEventArgs e)
    {
        var digito = e.Key.Length == 1 && char.IsAsciiDigit(e.Key[0]);
        _travarTeclas = digito || e.Key == "Backspace";
        if (digito) await AdicionarAsync(e.Key);
        else if (e.Key == "Backspace") Apagar();
    }

    private async Task AdicionarAsync(string digito)
    {
        if (_aEntrar || _pin.Length >= RegrasPin.Tamanho) return;
        _erro = null;
        _pin += digito;
        if (_pin.Length == RegrasPin.Tamanho) await Entrar();
    }

    private void Apagar()
    {
        if (_aEntrar || _pin.Length == 0) return;
        _pin = _pin[..^1];
        _erro = null;
    }

    private async Task Entrar()
    {
        if (_aEntrar) return;

        if (!RegrasPin.FormatoValido(_pin)) return;
        _erro = null;

        _aEntrar = true;
        try
        {
            var resultado = await Sessao.EntrarAsync(_pin);
            _pin = "";
            if (resultado.Sucesso)
            {
                Nav.NavigateTo("", replace: true);
                return;
            }
            _erro = resultado.Erro switch
            {
                ErroLogin.Rede => "Não foi possível ligar ao servidor. Verifique a ligação e tente outra vez.",
                ErroLogin.DemasiadasTentativas => "Demasiadas tentativas. Aguarde um minuto e tente outra vez.",
                _ => "PIN incorreto."
            };
        }
        catch (Exception)
        {
            _pin = "";
            _erro = "Não foi possível entrar. Tente outra vez.";
        }
        finally
        {
            _aEntrar = false;
            _focarAlerta = _erro is not null;
        }
    }
}
