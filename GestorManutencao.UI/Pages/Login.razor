@page "/login"
@layout Layout.LoginLayout
@inject SessaoService Sessao
@inject NavigationManager Nav

<PageTitle>Entrar · Gestor de Manutenção</PageTitle>

<div class="login">
    <aside class="login-marca">
        <Logo />
        <div class="login-marca-texto">
            <p class="sobretitulo">Gestor de Manutenção</p>
            <p class="login-marca-frase">As intervenções do seu turno, num só sítio.</p>
        </div>
    </aside>

    <section class="login-painel" aria-labelledby="titulo-login">
        <form class="login-form" @onsubmit="Entrar" novalidate>
            <h1 id="titulo-login">Entrar</h1>
            <p class="login-sub">Escreva o seu PIN de 6 números.</p>

            @if (_erro is not null)
            {
                <div class="alerta" role="alert" tabindex="-1" @ref="_alerta">
                    <Icone Nome="triangle-alert" />
                    <span>@_erro</span>
                </div>
            }

            <div class="campo">
                <label for="pin">PIN</label>
                <div class="entrada">
                    <Icone Nome="lock" Classe="entrada-icone" />
                    <input id="pin" name="pin" class="campo-pin" type="@(_mostrar ? "text" : "password")" inputmode="numeric" pattern="[0-9]*"
                           maxlength="6" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="go" required
                           aria-invalid="@(_semPin ? "true" : null)" aria-describedby="@(_semPin ? "erro-pin" : null)"
                           value="@_pin" @oninput="AoEscrever" />
                    <button type="button" class="entrada-acao" aria-pressed="@_mostrar.ToString().ToLowerInvariant()"
                            aria-label="@(_mostrar ? "Esconder PIN" : "Mostrar PIN")" @onclick="AlternarMostrar">
                        <Icone Nome="@(_mostrar ? "eye-off" : "eye")" />
                    </button>
                </div>
                @if (_semPin)
                {
                    <p class="campo-erro" id="erro-pin">O PIN tem 6 números.</p>
                }
            </div>

            <button type="submit" class="btn btn-primario" disabled="@_aEntrar" aria-busy="@_aEntrar.ToString().ToLowerInvariant()">
                @if (_aEntrar)
                {
                    <span class="spinner" aria-hidden="true"></span>
                    <span>A entrar…</span>
                }
                else
                {
                    <Icone Nome="log-in" />
                    <span>Entrar</span>
                }
            </button>

            <p class="login-rodape">Sem acesso ou esqueceu o PIN? Fale com o seu supervisor.</p>
            <p class="login-credito">Desenvolvido por SigmaCode</p>
        </form>
    </section>
</div>

@code {
    private string _pin = "";
    private bool _mostrar;
    private bool _aEntrar;
    private bool _semPin;
    private string? _erro;
    private ElementReference _alerta;
    private bool _focarAlerta;

    protected override async Task OnInitializedAsync()
    {
        await Sessao.RestaurarAsync();
        if (Sessao.TemSessao) Nav.NavigateTo("", replace: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focarAlerta && _erro is not null)
        {
            _focarAlerta = false;
            await _alerta.FocusAsync();
        }
    }

    private void AlternarMostrar() => _mostrar = !_mostrar;

    // Só números; ao chegar aos 6 entra sozinho.
    private async Task AoEscrever(ChangeEventArgs e)
    {
        _pin = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).Take(RegrasPin.Tamanho).ToArray());
        _semPin = false;
        if (_pin.Length == RegrasPin.Tamanho) await Entrar();
    }

    private async Task Entrar()
    {
        if (_aEntrar) return;

        _semPin = !RegrasPin.FormatoValido(_pin);
        _erro = null;
        if (_semPin) return;

        _aEntrar = true;
        try
        {
            var resultado = await Sessao.EntrarAsync(_pin);
            _pin = "";
            if (resultado.Sucesso)
            {
                Nav.NavigateTo("", replace: true);
                return;
            }
            _erro = resultado.Erro switch
            {
                ErroLogin.Rede => "Não foi possível ligar ao servidor. Verifique a ligação e tente outra vez.",
                ErroLogin.DemasiadasTentativas => "Demasiadas tentativas. Aguarde um minuto e tente outra vez.",
                _ => "PIN incorreto."
            };
        }
        catch (Exception)
        {
            _pin = "";
            _erro = "Não foi possível entrar. Tente outra vez.";
        }
        finally
        {
            _aEntrar = false;
            _focarAlerta = _erro is not null;
        }
    }
}
