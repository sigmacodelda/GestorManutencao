@page "/pecas/arrumar"
@inject IPecasService Pecas
@inject SessaoService Sessao
@inject ToastService Toast
@inject IPreferenciasLeitura Preferencias
@inject IDetetorLeitor Detetor

<PageTitle>Arrumação · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href=""><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Arrumação</h1>
    </div>

    @if (Sessao.EQualidade)
    {
        <p class="estado-lista" role="status">Esta área é para operadores e supervisores.</p>
    }
    else
    {
        @if (BarraCamara)
        {
            @* Botão da câmara sempre à mão no topo, como na ficha. *@
            <div class="picar-topo">
                <button type="button" id="picar-camara" class="btn btn-secundario" disabled="@_a_gravar" @onclick="PicarComCameraAsync">
                    <Icone Nome="camera" /><span>Picar com a câmara</span>
                </button>
            </div>
        }
        <p class="passo-atual" role="status">Passo @Passo de 3 · @TextoPasso</p>

        @* Mesma escolha da ficha (picar ou pesquisar, por qualquer ordem); aqui o lugar é o destino da peça. *@
        <PecaLugar @ref="_pl" IdCampo="arrumar-peca" LugarDestino="true" OnMudou="AoMudarAsync" SemBotaoCamara="BarraCamara" />
        <p class="campo-erro" role="alert">@_erro</p>

        @if (_esc?.Lugares is { } lug && _esc.Ref is not null)
        {
            <p class="intervencao-desc">Stock @lug.Stock.ToString("0.###") · À espera de arrumar @lug.PorArrumar.ToString("0.###")</p>
            @if (lug.PorArrumar <= 0)
            {
                <p class="estado-lista" role="status">Esta peça não tem nada à espera de arrumar: só se arruma o que lá está.</p>
            }
            @if (_esc.Local is null && lug.Lugares.Count > 0)
            {
                <h2 class="ficha-texto">Ou escolha um lugar da peça</h2>
                <ul class="lista-intervencoes">
                    @foreach (var l in lug.Lugares)
                    {
                        <li>
                            <button type="button" class="intervencao" @onclick="() => EscolherLugarAsync(l)">
                                <span class="intervencao-titulo">@l.Texto</span>
                                <span class="intervencao-desc">@l.Qtt.ToString("0.###") unidades</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        }

        @if (Passo == 3 && _esc?.Lugares is { PorArrumar: > 0 } pa)
        {
            <form class="formulario" @onsubmit="ArrumarAsync" novalidate>
                <div class="campo">
                    <label for="arrumar-qtt">Quantidade a arrumar</label>
                    <input id="arrumar-qtt" type="text" inputmode="decimal" autocomplete="off" maxlength="12" @bind="_qttTexto" @bind:event="oninput" />
                </div>
                @if (LogicaPicagem.LerQuantidade(_qttTexto, out var proposta) && proposta > pa.PorArrumar)
                {
                    <p class="campo-erro" role="alert">Só pode arrumar o que está à espera de arrumar (@pa.PorArrumar.ToString("0.###")).</p>
                }
                <button type="submit" class="btn btn-primario btn-grande" disabled="@_a_gravar"><Icone Nome="check" /><span>@(_a_gravar ? "A gravar…" : "Arrumar")</span></button>
            </form>
        }

        @if (_ultimo is not null && _esc?.Ref is null)
        {
            <h2 class="ficha-texto">Lugares atualizados · @_ultimo.Ref</h2>
            <ul class="lista-intervencoes">
                @foreach (var l in _ultimo.Lugares)
                {
                    <li class="intervencao">
                        <span class="intervencao-titulo">@l.Texto</span>
                        <span class="intervencao-desc">@l.Qtt.ToString("0.###") unidades</span>
                    </li>
                }
            </ul>
            <p class="estado-lista" role="status">À espera de arrumar: @_ultimo.PorArrumar.ToString("0.###")</p>
        }
    }
</section>

@code {
    private PecaLugar? _pl;
    private EscolhaPecaLugar? _esc;
    private LocalizacoesPeca? _ultimo;
    private string _erro = "", _qttTexto = "";
    private bool _a_gravar;

    private int Passo => _esc?.Ref is null ? 1 : _esc.Local is null ? 2 : 3;
    private string TextoPasso => Passo switch
    {
        1 => "pique a etiqueta da peça ou procure-a",
        2 => "pique a etiqueta do lugar de destino",
        _ => "indique a quantidade"
    };

    // Só com a câmara há botão (no leitor industrial a picada vem do campo escondido).
    private bool BarraCamara => !Sessao.EQualidade && LogicaLeitura.ModoEfetivo(Preferencias.Modo, Detetor.PareceLeitorIndustrial) == ModoLeitura.Camara;

    private Task PicarComCameraAsync() => _pl?.PicarComCameraAsync() ?? Task.CompletedTask;

    // Mudou a escolha: peça nova propõe arrumar tudo o que está à espera.
    private Task AoMudarAsync(EscolhaPecaLugar e)
    {
        var pecaNova = e.Ref is not null && e.Ref != _esc?.Ref;
        _esc = e;
        if (pecaNova)
        {
            _erro = "";
            _ultimo = null;
            _qttTexto = e.Lugares is { PorArrumar: > 0 } l ? LogicaPicagem.TextoQuantidade(l.PorArrumar) : "";
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task EscolherLugarAsync(Lugar l) => _pl?.DefinirLugarAsync(l) ?? Task.CompletedTask;

    // A gravação corre na fila das leituras do componente: uma picada que chegue durante o envio
    // espera e aplica-se depois da limpeza, em vez de ser apagada por ela.
    private async Task ArrumarAsync()
    {
        if (_a_gravar || _pl is null || _esc is not { Ref: not null, Local: not null }) return;
        _erro = "";
        var refPeca = _esc.Ref;
        _a_gravar = true;
        try
        {
            await _pl.GravarAsync(async esc =>
            {
                if (!LogicaPicagem.LerQuantidade(_qttTexto, out var qtt))
                {
                    _erro = "Quantidade inválida: use um número positivo, com vírgula ou ponto e no máximo 3 casas decimais.";
                    return false;
                }
                if (esc.Lugares is not { } lug || qtt > lug.PorArrumar)
                {
                    _erro = $"Só pode arrumar o que está à espera de arrumar ({esc.Lugares?.PorArrumar.ToString("0.###") ?? "?"}).";
                    return false;
                }
                _ultimo = await Pecas.ArrumarAsync(esc.Ref!, esc.Local!, qtt);
                Toast.Sucesso($"Arrumado: {LogicaPicagem.TextoQuantidade(qtt)} de {esc.Ref}");
                _qttTexto = "";
                return true;
            });
        }
        catch (Exception e) when (e is InvalidOperationException or HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized })
        {
            _erro = MensagensGestao.Para(e, "Não foi possível arrumar. Tente outra vez.");
        }
        catch
        {
            // Falha sem resposta clara (rede, tempo, 503): o POST pode ter gravado; não se repete às cegas.
            // Mostra o que está realmente no armazém e obriga a voltar a escolher.
            _erro = "Confirme os lugares antes de repetir.";
            try { _ultimo = await Pecas.LugaresAsync(refPeca!) ?? _ultimo; } catch { }
            await _pl.LimparAsync();
        }
        finally { _a_gravar = false; }
    }
}
