@page "/intervencoes/{Id}"
@implements IDisposable
@inject IIntervencoesService Intervencoes
@inject IGestorOffline Offline
@inject NavigationManager Nav
@inject ICamara Camara
@inject SessaoService Sessao
@inject ToastService Toast

<PageTitle>Intervenção · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="@(Sessao.Modo == ModoTrabalho.Supervisor ? "fichas" : "intervencoes")"><Icone Nome="arrow-left" /><span>@(Sessao.Modo == ModoTrabalho.Supervisor ? "Todas as fichas" : "As minhas intervenções")</span></a>
        <h1 tabindex="-1">@(_i?.Equipamento ?? "Intervenção")</h1>
    </div>

    @if (_a_carregar)
    {
        <p class="estado-lista" role="status">A carregar…</p>
    }
    else if (_i is null)
    {
        <p class="estado-lista" role="status">@(_indisponivel ? "Esta parte ainda não está disponível." : "Intervenção não encontrada.")</p>
    }
    else
    {
        @if (_i.Estado == EstadoIntervencao.EmCurso && !string.IsNullOrWhiteSpace(_i.Motivo))
        {
            <div class="alerta alerta-devolvida" role="alert">
                <Icone Nome="rotate-ccw" />
                <div>
                    <strong>Devolvida pelo supervisor</strong>
                    <p>@_i.Motivo</p>
                </div>
            </div>
        }

        @if (_i.Pendente)
        {
            <div class="alerta-pendente" role="status">
                <Icone Nome="clock" />
                <div>
                    <strong>Por enviar</strong>
                    <p>@(Offline.SemLigacao ? "Guardado. Será enviado quando houver rede." : "Guardado. Vai ser enviado assim que for possível.")</p>
                </div>
            </div>
        }

        @if (_i.Estado == EstadoIntervencao.EmCurso && _i.PodePausar && _i.EmPausa)
        {
            <div class="chips"><span class="chip chip-aviso" role="status"><Icone Nome="pause" /> Em pausa</span></div>
        }

        <dl class="ficha">
            @if (!string.IsNullOrWhiteSpace(_i.Zona)) { <dt>Zona</dt><dd>@_i.Zona</dd> }
            <dt>Tipo</dt><dd>@(_i.Tipo == TipoIntervencao.Curativa ? "Avaria" : "Preventiva")</dd>
            <dt>Data prevista</dt><dd>@_i.DataPlaneada.ToString("dd/MM/yyyy")</dd>
            @if (_i.OutrosTecnicos.Count > 0)
            {
                <dt>Técnico principal</dt><dd>@(_i.Tecnico ?? "PHC " + _i.Tecno)</dd>
                <dt>Outros técnicos</dt><dd>@string.Join(", ", _i.OutrosTecnicos.Select(a => a.Nome))</dd>
            }
            @if (!string.IsNullOrWhiteSpace(_i.Anomalia)) { <dt>Problema</dt><dd>@_i.Anomalia</dd> }
        </dl>

        @* A ficha completa (horas, mão de obra, externos, dados de gestão) é do supervisor; o técnico só vê o essencial. *@
        @if (Sessao.Modo == ModoTrabalho.Supervisor)
        {
            <FichaCompleta Detalhe="_d" Aviso="_avisoOnline" OnMudou="RecarregarAsync" />
        }

        @if (_i.Estado is EstadoIntervencao.EmCurso or EstadoIntervencao.Concluida)
        {
            <section class="fotos" aria-labelledby="titulo-fotos">
                <h2 id="titulo-fotos" class="titulo-grupo"><Icone Nome="camera" /> Fotos <span class="contagem">@_fotos.Count</span></h2>
                @if (_fotos.Count == 0)
                {
                    <p class="estado-lista" role="status">Ainda sem fotos.</p>
                }
                <ul class="fotos-grelha">
                    @foreach (var f in _fotos)
                    {
                        <li class="foto">
                            @if (_miniaturas.TryGetValue(f.Id, out var url))
                            {
                                <img src="@url" alt="@f.Nome" />
                            }
                            @if (ClassificacaoErros.IdLocal(f.Id))
                            {
                                <span class="chip chip-pendente foto-pendente">Por enviar</span>
                            }
                            @if (_i.Estado == EstadoIntervencao.EmCurso && !_viaDetalhe)
                            {
                                <button type="button" class="btn-texto foto-apagar" aria-label="Tirar a foto @f.Nome" disabled="@_a_gravar" @onclick="() => ApagarFotoAsync(f)"><Icone Nome="trash" /></button>
                            }
                        </li>
                    }
                </ul>
                @if (_i.Estado == EstadoIntervencao.EmCurso && !_viaDetalhe && _fotos.Count < RegrasFoto.Max)
                {
                    @if (Camara.Disponivel)
                    {
                        <button type="button" class="btn btn-secundario" disabled="@_a_gravar" @onclick="TirarFotoAsync"><Icone Nome="camera" /><span>Tirar foto</span></button>
                    }
                    else
                    {
                        <label class="btn btn-secundario @(_a_gravar ? "desativado" : "")">
                            <Icone Nome="camera" /><span>Tirar foto</span>
                            <InputFile accept="image/*" capture="environment" class="foto-entrada" disabled="@_a_gravar" OnChange="AdicionarFotoAsync" />
                        </label>
                    }
                    <label class="btn btn-secundario @(_a_gravar ? "desativado" : "")">
                        <Icone Nome="plus" /><span>Escolher da galeria</span>
                        <InputFile accept="image/*" class="foto-entrada" disabled="@_a_gravar" OnChange="AdicionarFotoAsync" />
                    </label>
                }
                <p class="campo-erro" role="alert">@_erroFoto</p>
            </section>
        }

        @if (!_viaDetalhe && _i.Estado == EstadoIntervencao.EmCurso)
        {
            <div class="formulario">
                <div class="campo">
                    <label for="feito">O que fez?</label>
                    <textarea id="feito" rows="4" maxlength="254" @bind="_feito" @bind:event="oninput"></textarea>
                    <Microfone @bind-Texto="_feito" MaxLength="254" />
                </div>
                @if (Sessao.Modo == ModoTrabalho.Supervisor)
                {
                    <div class="horas">
                        <div class="campo">
                            <label for="inicio">Hora de início</label>
                            <input id="inicio" type="time" @bind="_inicio" />
                        </div>
                        <div class="campo">
                            <label for="fim">Hora de fim</label>
                            <input id="fim" type="time" @bind="_fim" />
                            <button type="button" class="btn-texto" @onclick="() => _fim = TimeOnly.FromDateTime(DateTime.Now)">Agora</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_i.Estado is EstadoIntervencao.EmCurso or EstadoIntervencao.Concluida)
        {
            <section class="materiais" aria-labelledby="titulo-materiais">
                <h2 id="titulo-materiais" class="titulo-grupo"><Icone Nome="package" /> Material usado <span class="contagem">@_materiais.Count</span></h2>
                @if (_materiais.Count == 0)
                {
                    <p class="estado-lista" role="status">Ainda sem material.</p>
                }
                <ul class="lista-intervencoes">
                    @foreach (var m in _materiais)
                    {
                        <li class="intervencao material-linha">
                            <span>
                                <span class="intervencao-titulo">@m.Design</span>
                                @if (ClassificacaoErros.IdLocal(m.Id)) { <span class="chip chip-pendente">Por enviar</span> }
                                <br />
                                <span class="intervencao-desc">@m.Qtt.ToString("0.###") × @m.Epv.ToString("0.00") € = @m.Custo.ToString("0.00") €</span>
                            </span>
                            @if (_d is { PodeEditar: true } && !ClassificacaoErros.IdLocal(m.Id))
                            {
                                <button type="button" class="btn-texto" aria-label="Editar @m.Design" disabled="@_a_gravar" @onclick="() => EditarMaterial(m)"><Icone Nome="wrench" /></button>
                            }
                            @if (_i.Estado == EstadoIntervencao.EmCurso)
                            {
                                <button type="button" class="btn-texto" aria-label="Tirar @m.Design" disabled="@_a_gravar" @onclick="() => ApagarMaterialAsync(m)"><Icone Nome="trash" /></button>
                            }
                        </li>
                    }
                </ul>
                @if (_matEditId is not null)
                {
                    <form class="formulario" @onsubmit="GuardarMaterialEditadoAsync" novalidate>
                        <div class="material-novo">
                            <div class="campo">
                                <label for="e-material">Material</label>
                                <input id="e-material" type="text" maxlength="35" autocomplete="off" @bind="_eDesign" @bind:event="oninput" />
                            </div>
                            <div class="campo">
                                <label for="e-qtt">Quantidade</label>
                                <input id="e-qtt" type="number" inputmode="decimal" step="any" min="0" @bind="_eQtt" />
                            </div>
                            <div class="campo">
                                <label for="e-epv">Preço (€)</label>
                                <input id="e-epv" type="number" inputmode="decimal" step="any" min="0" @bind="_eEpv" />
                            </div>
                        </div>
                        <p class="campo-erro" role="alert">@_erroMaterial</p>
                        <button type="submit" class="btn btn-secundario" disabled="@_a_gravar"><Icone Nome="check" /><span>Guardar material</span></button>
                        <button type="button" class="btn-texto" @onclick="() => _matEditId = null">Deixar de editar</button>
                    </form>
                }
                @if (_i.Estado == EstadoIntervencao.EmCurso)
                {
                    <form class="formulario" @onsubmit="AdicionarMaterialAsync" novalidate>
                        <div class="material-novo">
                            <div class="campo">
                                <label for="material">Material</label>
                                <input id="material" type="text" maxlength="35" autocomplete="off" @bind="_material" @bind:event="oninput" />
                                <Microfone @bind-Texto="_material" MaxLength="35" />
                            </div>
                            <div class="campo">
                                <label for="qtt">Quantidade</label>
                                <input id="qtt" type="number" inputmode="decimal" step="any" min="0" @bind="_qtt" />
                            </div>
                            <div class="campo">
                                <label for="epv">Preço (€, se souber)</label>
                                <input id="epv" type="number" inputmode="decimal" step="any" min="0" @bind="_epv" />
                            </div>
                        </div>
                        <p class="campo-erro" role="alert">@_erroMaterial</p>
                        <button type="submit" class="btn btn-secundario" disabled="@_a_gravar"><Icone Nome="plus" /><span>Juntar material</span></button>
                    </form>
                }
            </section>
        }

        @if (_viaDetalhe)
        {
            @* Ficha de outra pessoa: o supervisor trata dela na ficha completa (acima). *@
        }
        else if (_i.Estado == EstadoIntervencao.Planeada)
        {
            <button type="button" class="btn btn-primario btn-grande" disabled="@_a_gravar" @onclick="IniciarAsync"><Icone Nome="play" /><span>Começar</span></button>
        }
        else if (_i.Estado == EstadoIntervencao.EmCurso)
        {
            <p class="campo-erro" role="alert">@_erro</p>
            @* Feito à direita (row-reverse); Pausar/Retomar ao lado, ambos fixos ao fundo. *@
            <div class="barra-fixa">
                <button type="button" class="btn btn-primario btn-grande" disabled="@_a_gravar" @onclick="ConcluirAsync"><Icone Nome="check" /><span>@(_a_gravar && _pausa is null ? "A guardar…" : "Feito")</span></button>
                @if (_i.PodePausar && _i.EmPausa)
                {
                    <button type="button" class="btn btn-secundario btn-grande" disabled="@_a_gravar" @onclick="RetomarAsync"><Icone Nome="play" /><span>@(_pausa == false ? "A retomar…" : "Retomar")</span></button>
                }
                else if (_i.PodePausar)
                {
                    <button type="button" class="btn btn-secundario btn-grande" disabled="@_a_gravar" @onclick="PausarAsync"><Icone Nome="pause" /><span>@(_pausa == true ? "A pausar…" : "Pausar")</span></button>
                }
            </div>
        }
        else
        {
            <div class="sucesso" role="status">
                <span class="sucesso-icone"><Icone Nome="circle-check" /></span>
                <p class="sucesso-titulo">@(_i.Estado == EstadoIntervencao.Concluida ? "Feito! Obrigado." : _i.Estado == EstadoIntervencao.Cancelada ? "Foi cancelada." : "Já está fechada.")</p>
                @if (_i.Estado == EstadoIntervencao.Concluida) { <p class="sucesso-desc">O supervisor vai ver e confirmar.</p> }
                <a class="btn btn-primario btn-grande" href="intervencoes"><span>Ver as minhas intervenções</span></a>
            </div>
        }
    }
</section>

@code {
    [Parameter] public string Id { get; set; } = "";

    private Intervencao? _i;
    private string _feito = "", _erro = "", _material = "", _erroMaterial = "";
    private decimal? _qtt, _epv;
    private IReadOnlyList<Material> _materiais = [];
    private IReadOnlyList<Foto> _fotos = [];
    private readonly Dictionary<string, string> _miniaturas = [];
    private string _erroFoto = "";
    private TimeOnly? _inicio, _fim;
    private bool _a_carregar = true, _a_gravar, _indisponivel;
    private FichaDetalhe? _d;
    // A ficha veio só do detalhe do supervisor: não é do utilizador, por isso não se começa nem se conclui aqui.
    private bool _viaDetalhe;
    private string? _avisoOnline, _matEditId, _eDesign;
    private decimal? _eQtt, _eEpv;

    protected override void OnInitialized() => Offline.Mudou += AoMudarOffline;

    public void Dispose() => Offline.Mudou -= AoMudarOffline;

    // A avaria registada sem rede tinha um id local; quando já foi criada no servidor a rota passa a usar o id real.
    private async Task<bool> IrParaIdRealAsync()
    {
        var real = await Offline.ResolverIdAsync(Id);
        if (real == Id) return false;
        Nav.NavigateTo($"intervencoes/{Uri.EscapeDataString(real)}", replace: true);
        return true;
    }

    // Quando termina o envio, a ficha deixa de estar "por enviar": volta a ler o que está guardado.
    private void AoMudarOffline() => InvokeAsync(async () =>
    {
        if (_i is not { Pendente: true } || _a_gravar || _a_carregar || Offline.Estado == EstadoSincronizacao.ASincronizar) return;
        try
        {
            if (await IrParaIdRealAsync()) return;
            if (await Intervencoes.ObterAsync(Id) is { } ficha) _i = ficha;
            await CarregarMateriaisAsync();
            await CarregarFotosAsync();
        }
        catch (Exception) { /* fica como está até à próxima leitura */ }
        StateHasChanged();
    });

    private async Task RefrescarFichaAsync()
    {
        try { if (await Intervencoes.ObterAsync(Id) is { } ficha) _i = ficha; }
        catch (Exception) { /* mantém a ficha que já tem */ }
        // Ficha de outra pessoa: o material vem do detalhe, que se relê para mostrar o que acabou de ser gravado.
        if (_viaDetalhe) await CarregarDetalheAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _a_carregar = true;
        _d = null; _feito = "";
        try
        {
            if (await IrParaIdRealAsync()) return;
            // O supervisor sem número de técnico não tem fichas suas: segue para o detalhe, que é de qualquer ficha.
            try { Usar(await Intervencoes.ObterAsync(Id)); }
            catch (SemNumeroTecnicoException) when (Sessao.PodeSerSupervisor) { Usar(null); }
            await CarregarDetalheAsync();
            // O supervisor abre qualquer ficha: se não é sua, a ficha vem do detalhe.
            _viaDetalhe = false;
            if (_i is null && _d is not null) { Usar(SeccoesFicha.ParaIntervencao(_d)); _viaDetalhe = true; }
            await CarregarMateriaisAsync(); await CarregarFotosAsync();
        }
        catch (NotSupportedException) { _indisponivel = true; }
        catch (Exception) { _erro = "Não foi possível carregar."; }
        finally { _a_carregar = false; }
    }

    // A ficha completa só existe online; sem rede ou com a ficha por enviar, fica o aviso e o resto do ecrã funciona como antes.
    // Troca a ficha completa só quando a nova chega (sem passar por "nada"), para o ecrã não piscar nem perder o que está a escrever.
    private async Task CarregarDetalheAsync()
    {
        if (ClassificacaoErros.IdLocal(Id) || _i is { Pendente: true }) { _d = null; _avisoOnline = "A ficha completa fica disponível depois de a intervenção ser enviada."; return; }
        try
        {
            _d = await Intervencoes.ObterDetalheAsync(Id); _avisoOnline = null;
            // "O que fez?" parte do que já está gravado na resolução e nunca o apaga se o utilizador não escrever.
            if (string.IsNullOrWhiteSpace(_feito) && _d is { Resolucao.Length: > 0 }) _feito = _d.Resolucao;
        }
        catch (InvalidOperationException ex) { _avisoOnline = ex.Message == MensagensIntervencao.SemRede ? "Sem ligação: a ficha completa só se vê com rede." : ex.Message; }
        catch (NotSupportedException) { _d = null; _avisoOnline = null; }
        catch (Exception) { _avisoOnline = "Não foi possível carregar a ficha completa."; }
    }

    private async Task RecarregarAsync()
    {
        await RefrescarFichaAsync();
        await CarregarDetalheAsync();
        if (_i is null && _d is not null) Usar(SeccoesFicha.ParaIntervencao(_d));
        else if (_i is not null && _d is not null) Usar(_i with { Estado = _d.Estado, Motivo = _d.Motivo ?? _i.Motivo });
        await CarregarMateriaisAsync();
        StateHasChanged();
    }

    private void EditarMaterial(Material m) { _matEditId = m.Id; _eDesign = m.Design; _eQtt = m.Qtt; _eEpv = m.Epv; _erroMaterial = ""; }

    private async Task GuardarMaterialEditadoAsync()
    {
        _erroMaterial = RegrasMaterial.Validar(_eDesign, _eQtt, _eEpv) ?? "";
        if (_erroMaterial.Length > 0 || _matEditId is null) return;
        _a_gravar = true;
        try
        {
            await Intervencoes.EditarMaterialAsync(Id, _matEditId, _eDesign!.Trim(), _eQtt!.Value, _eEpv ?? 0);
            _matEditId = null;
            await RecarregarAsync();
        }
        catch (InvalidOperationException ex) { _erroMaterial = ex.Message; }
        catch (Exception) { _erroMaterial = "Não foi possível guardar. Tente outra vez."; }
        finally { _a_gravar = false; }
    }

    private void Usar(Intervencao? i)
    {
        _i = i;
        if (string.IsNullOrWhiteSpace(_feito) && !string.IsNullOrWhiteSpace(i?.Feito)) _feito = i!.Feito!;
        _inicio = i?.HoraInicio;
        _fim = i?.HoraFim ?? TimeOnly.FromDateTime(DateTime.Now);
    }

    private async Task CarregarMateriaisAsync()
    {
        _materiais = [];
        if (_i is not { Estado: EstadoIntervencao.EmCurso or EstadoIntervencao.Concluida }) return;
        if (_viaDetalhe && _d is not null) { _materiais = _d.ListaMateriais; return; }
        try { _materiais = await Intervencoes.ListarMateriaisAsync(Id); }
        catch (Exception) { _materiais = []; }
    }

    private async Task CarregarFotosAsync()
    {
        _fotos = []; _miniaturas.Clear();
        if (_i is not { Estado: EstadoIntervencao.EmCurso or EstadoIntervencao.Concluida }) return;
        try
        {
            _fotos = await Intervencoes.ListarFotosAsync(Id);
            foreach (var f in _fotos)
                if (await Intervencoes.ObterFotoAsync(Id, f.Id) is { } dados) _miniaturas[f.Id] = "data:image/jpeg;base64," + Convert.ToBase64String(dados);
        }
        catch (Exception) { _erroFoto = "Não foi possível carregar as fotos."; }
    }

    // A foto é reduzida no próprio telemóvel (JPEG, lado maior 1600 px) antes de seguir.
    private async Task AdicionarFotoAsync(InputFileChangeEventArgs e)
    {
        await GuardarFotoAsync(async () =>
        {
            var reduzida = await e.File.RequestImageFileAsync("image/jpeg", RegrasFoto.LadoMaximo, RegrasFoto.LadoMaximo);
            await using var fluxo = reduzida.OpenReadStream(RegrasFoto.MaxBytes);
            using var memoria = new MemoryStream();
            await fluxo.CopyToAsync(memoria);
            return memoria.ToArray();
        });
    }

    private Task TirarFotoAsync() =>
        GuardarFotoAsync(() => Camara.TirarFotoAsync(RegrasFoto.LadoMaximo, RegrasFoto.MaxBytes));

    private async Task GuardarFotoAsync(Func<Task<byte[]?>> obter)
    {
        _erroFoto = "";
        _a_gravar = true;
        try
        {
            if (await obter() is not { } dados) return;
            await Intervencoes.AdicionarFotoAsync(Id, $"foto_{DateTime.Now:yyyyMMdd_HHmmss}", dados);
            await RefrescarFichaAsync();
            await CarregarFotosAsync();
        }
        catch (InvalidOperationException ex) { _erroFoto = ex.Message; }
        catch (IOException) { _erroFoto = "A foto é demasiado grande. Tente outra vez."; }
        catch (Exception) { _erroFoto = "Não foi possível guardar a foto. Tente outra vez."; }
        finally { _a_gravar = false; }
    }

    private async Task ApagarFotoAsync(Foto f)
    {
        _a_gravar = true; _erroFoto = "";
        try { await Intervencoes.ApagarFotoAsync(Id, f.Id); await RefrescarFichaAsync(); await CarregarFotosAsync(); }
        catch (Exception) { _erroFoto = "Não foi possível tirar a foto. Tente outra vez."; }
        finally { _a_gravar = false; }
    }

    private async Task AdicionarMaterialAsync()
    {
        _erroMaterial = RegrasMaterial.Validar(_material, _qtt, _epv) ?? "";
        if (_erroMaterial.Length > 0) return;
        _a_gravar = true;
        try
        {
            await Intervencoes.AdicionarMaterialAsync(Id, _material.Trim(), _qtt!.Value, _epv ?? 0);
            _material = ""; _qtt = _epv = null;
            await RefrescarFichaAsync();
            await CarregarMateriaisAsync();
        }
        catch (InvalidOperationException ex) { _erroMaterial = ex.Message; }
        catch (Exception) { _erroMaterial = "Não foi possível guardar. Tente outra vez."; }
        finally { _a_gravar = false; }
    }

    private async Task ApagarMaterialAsync(Material m)
    {
        _a_gravar = true; _erroMaterial = "";
        try { await Intervencoes.ApagarMaterialAsync(Id, m.Id); await RefrescarFichaAsync(); await CarregarMateriaisAsync(); }
        catch (Exception) { _erroMaterial = "Não foi possível tirar o material. Tente outra vez."; }
        finally { _a_gravar = false; }
    }

    private async Task IniciarAsync() => await Gravar(() => Intervencoes.IniciarAsync(Id));

    // true = a pausar, false = a retomar, null = não está a pausar nem a retomar (o texto "A guardar…" é só do Feito).
    private bool? _pausa;

    private async Task PausarAsync()
    {
        _pausa = true;
        try { await Gravar(() => Intervencoes.PausarAsync(Id)); }
        finally { _pausa = null; }
        if (_erro.Length == 0 && _i is { EmPausa: true }) Toast.Sucesso("Intervenção em pausa");
    }

    private async Task RetomarAsync()
    {
        _pausa = false;
        try { await Gravar(() => Intervencoes.RetomarAsync(Id)); }
        finally { _pausa = null; }
        if (_erro.Length == 0 && _i is { EmPausa: false }) Toast.Sucesso("Intervenção retomada");
    }

    private async Task ConcluirAsync()
    {
        // Técnico: as horas são automáticas (início gravado ao começar, fim agora; nunca fim antes do início).
        if (Sessao.Modo != ModoTrabalho.Supervisor)
        {
            var agora = TimeOnly.FromDateTime(DateTime.Now);
            _inicio ??= agora;
            _fim = agora < _inicio ? _inicio : agora;
        }
        _erro = RegrasIntervencao.ValidarConclusao(_feito, _inicio, _fim) ?? "";
        if (_erro.Length > 0) return;
        await Gravar(() => Intervencoes.ConcluirAsync(Id, _feito, _inicio!.Value, _fim!.Value));
        // Feito: volta à lista (a que o utilizador usa no terreno) e confirma com um aviso de 2 s, sem ecrã de sucesso a pedir mais um toque.
        if (_erro.Length == 0 && _i is { Estado: EstadoIntervencao.Concluida })
        {
            Toast.Sucesso("Intervenção concluída");
            Nav.NavigateTo(Sessao.Modo == ModoTrabalho.Supervisor ? "planeadas" : "intervencoes");
        }
    }

    private async Task Gravar(Func<Task<Intervencao>> operacao)
    {
        _a_gravar = true; _erro = "";
        try { Usar(await operacao()); await CarregarDetalheAsync(); await CarregarMateriaisAsync(); await CarregarFotosAsync(); }
        catch (InvalidOperationException ex) { _erro = ex.Message; }
        catch (Exception) { _erro = "Não foi possível guardar. Tente outra vez."; }
        finally { _a_gravar = false; }
    }
}
