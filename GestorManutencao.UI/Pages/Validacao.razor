@page "/validacao"
@implements IDisposable
@inject SessaoService Sessao
@inject ToastService Toast
@inject IIntervencoesService Intervencoes
@inject NotificacaoService Notificacoes

<PageTitle>Validação · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="/"><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Validação</h1>
    </div>

    @if (!Sessao.PodeSerSupervisor)
    {
        <p class="estado-lista" role="status">Esta área é só para supervisores.</p>
    }
    else if (_a_carregar && EstadoRecarga.MostrarSpinner(_temDados))
    {
        <p class="estado-lista" role="status">A carregar…</p>
    }
    else if (_indisponivel)
    {
        <p class="estado-lista" role="status">Esta parte ainda não está disponível.</p>
    }
    else if (_falhou)
    {
        <div class="estado-lista" role="alert">
            <p>Não foi possível carregar as fichas.</p>
            <button type="button" class="btn btn-secundario" @onclick="CarregarAsync">Tentar outra vez</button>
        </div>
    }
    else
    {
        @if (_aviso is not null)
        {
            <p class="alerta alerta-pin" role="status"><Icone Nome="circle-check" /><span>@_aviso</span></p>
        }
        @if (_erro is not null)
        {
            <p class="alerta" role="alert"><Icone Nome="triangle-alert" /><span>@_erro</span></p>
        }
        @foreach (var c in _porConfirmar)
        {
            @* A ficha já ficou validada (sai da lista), mas as peças não saíram de conferência: repete-se a confirmação. *@
            <AvisoConferencia Aviso="@c.Aviso" Titulo="@($"Validada: {c.Equipamento}")" Ocupado="_ocupado" OnRepetir="() => RepetirConfirmacaoAsync(c)" />
        }
        @if (_fichas.Count == 0)
        {
            <p class="estado-lista" role="status">Não há fichas por validar. Está tudo em dia!</p>
        }
        else
        {
            <h2 class="titulo-grupo">Por validar <span class="contagem">@_fichas.Count</span></h2>
            <ul class="lista-intervencoes">
                @foreach (var f in _fichas.Take(_limite))
                {
                    <li class="intervencao ficha-validar">
                        <span class="intervencao-titulo">@f.Equipamento</span>
                        <span class="intervencao-desc">@(string.IsNullOrWhiteSpace(f.Zona) ? "Sem zona" : f.Zona)@(f.Tecnico is null ? "" : " · " + f.Tecnico)</span>
                        <span class="chips">
                            <span class="chip chip-ok">Concluída</span>
                            <span class="chip @(f.Tipo == TipoIntervencao.Curativa ? "chip-aviso" : "")">@(f.Tipo == TipoIntervencao.Curativa ? "Avaria" : "Preventiva")</span>
                        </span>
                        <span class="intervencao-data">@f.DataPlaneada.ToString("dd/MM")</span>
                        @if (!string.IsNullOrWhiteSpace(f.Anomalia))
                        {
                            <p class="ficha-texto"><strong>Problema:</strong> @f.Anomalia</p>
                        }
                        <p class="ficha-texto"><strong>Feito:</strong> @(f.Feito ?? "—")@(f.HoraInicio is null || f.HoraFim is null ? "" : $" ({f.HoraInicio:HH\\:mm}–{f.HoraFim:HH\\:mm})")</p>
                        @if (_materiais.TryGetValue(f.Id, out var mats))
                        {
                            <div class="ficha-texto">
                                <strong>Material:</strong>
                                @if (mats.Count == 0)
                                {
                                    <span> nenhum</span>
                                }
                                else
                                {
                                    <ul class="lista-material">
                                        @foreach (var m in mats)
                                        {
                                            <li>@m.Design · @LogicaPicagem.TextoUnidades(m.Qtt)@(string.IsNullOrWhiteSpace(m.Local) ? "" : " · " + (LogicaFichaPeca.TextoNormalDoLugar(m.Local) ?? m.Local))@(m.Ref != "" && !m.SaidaDada ? " · saída por dar" : "")</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(f.PedidoDevolucao))
                        {
                            <p class="ficha-texto"><span class="chip chip-aviso">Pedido de devolução</span> <strong>@(f.Tecnico ?? "O técnico") pede:</strong> @f.PedidoDevolucao</p>
                        }
                        @if (!f.PodeValidar)
                        {
                            <p class="ficha-texto">Concluiu esta ficha: tem de ser outra pessoa a validar.</p>
                        }
                        else if (_aDevolver == f.Id)
                        {
                            <div class="campo ficha-texto">
                                <label for="motivo-@f.Id">Porque devolve?</label>
                                <textarea id="motivo-@f.Id" rows="2" maxlength="254" @bind="_motivo" @bind:event="oninput"></textarea>
                                <Microfone @bind-Texto="_motivo" MaxLength="254" />
                            </div>
                            <div class="ficha-acoes">
                                <button type="button" class="btn" disabled="@(_ocupado || string.IsNullOrWhiteSpace(_motivo))" @onclick="() => DevolverAsync(f)">
                                    <Icone Nome="rotate-ccw" /><span>Devolver</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => _aDevolver = null">Cancelar</button>
                            </div>
                        }
                        else if (_aConfirmar == f.Id)
                        {
                            <div class="ficha-acoes">
                                <button type="button" class="btn" disabled="@_ocupado" @onclick="() => ValidarAsync(f)">
                                    <Icone Nome="circle-check" /><span>Confirmar</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => _aConfirmar = null">Cancelar</button>
                            </div>
                        }
                        else
                        {
                            <div class="ficha-acoes">
                                <button type="button" class="btn" disabled="@_ocupado" @onclick="() => { _aConfirmar = f.Id; _aDevolver = null; }">
                                    <Icone Nome="shield-check" /><span>Validar</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => { _aDevolver = f.Id; _aConfirmar = null; _motivo = string.Empty; }">
                                    <Icone Nome="rotate-ccw" /><span>Devolver</span>
                                </button>
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (_fichas.Count > _limite)
            {
                <button type="button" class="btn btn-secundario" @onclick="VerMaisAsync">Ver mais (@(_fichas.Count - _limite))</button>
            }
        }
    }
</section>

@code {
    private List<Intervencao> _fichas = [];
    private bool _a_carregar = true, _falhou, _indisponivel, _ocupado, _temDados;
    private string? _aConfirmar, _aDevolver, _aviso, _erro;
    private string _motivo = "";
    private const int PorPagina = 10;
    private int _limite = PorPagina;
    private readonly Dictionary<string, IReadOnlyList<Material>> _materiais = [];

    protected override async Task OnInitializedAsync()
    {
        Notificacoes.DadosMudaram += AoMudarDados;
        if (Sessao.PodeSerSupervisor) await CarregarAsync();
        else _a_carregar = false;
    }

    // O servidor avisa que as fichas mudaram: recarrega logo, salvo se o supervisor estiver a validar ou a devolver uma ficha.
    private void AoMudarDados() => InvokeAsync(async () =>
    {
        if (!Sessao.PodeSerSupervisor || _ocupado || _aConfirmar is not null || _aDevolver is not null) return;
        await CarregarAsync();
        StateHasChanged();
    });

    public void Dispose() => Notificacoes.DadosMudaram -= AoMudarDados;

    private async Task CarregarAsync()
    {
        _a_carregar = true; _falhou = false; _indisponivel = false; _aConfirmar = _aDevolver = null; _erro = null;
        try { _fichas = (await Intervencoes.ListarPorValidarAsync()).ToList(); _temDados = true; await CarregarMateriaisAsync(); }
        catch (NotSupportedException) { _indisponivel = true; }
        catch (Exception)
        {
            // Já havia lista: mantém-se e mostra-se o erro por cima.
            if (EstadoRecarga.FalhaSubstituiLista(_temDados)) _falhou = true;
            else _erro = "Não foi possível atualizar a lista. Tente outra vez.";
        }
        finally { _a_carregar = false; }
    }

    // O supervisor valida o que o técnico gastou: o material vem com a lista. Uma falha numa ficha só a deixa sem material, não a lista toda.
    private async Task CarregarMateriaisAsync()
    {
        _materiais.Clear();
        var antes = _fichas.Take(_limite).ToList();
        var lidos = await Task.WhenAll(antes.Select(async f =>
        {
            // O detalhe é o que o supervisor pode ler (a lista de materiais da API é só do técnico da ficha).
            try { return (f.Id, Lista: (await Intervencoes.ObterDetalheAsync(f.Id))?.ListaMateriais); }
            catch (Exception) { return (f.Id, Lista: (IReadOnlyList<Material>?)null); }
        }));
        foreach (var (id, lista) in lidos) if (lista is not null) _materiais[id] = lista;
    }

    private sealed record PorConfirmar(string Id, string Equipamento, string Aviso);
    private readonly List<PorConfirmar> _porConfirmar = [];

    private Task ValidarAsync(Intervencao f) => AgirAsync(f, async () =>
    {
        var validada = await Intervencoes.ValidarAsync(f.Id);
        if (!string.IsNullOrWhiteSpace(validada.AvisoStock)) _porConfirmar.Add(new(f.Id, f.Equipamento, validada.AvisoStock));
        return validada;
    }, $"Validada: {f.Equipamento}. Segue para a Qualidade.");

    // Repetir é seguro: a API só volta a tentar a confirmação das peças.
    private async Task RepetirConfirmacaoAsync(PorConfirmar c)
    {
        _ocupado = true; _aviso = _erro = null;
        try
        {
            var r = await Intervencoes.ValidarAsync(c.Id);
            var pos = _porConfirmar.IndexOf(c);
            // Sem rede o pedido só ficou na fila (Pendente): nada foi confirmado, o aviso fica.
            var res = LogicaConferencia.AposRepetir(c.Aviso, r);
            if (res.Confirmada)
            {
                _porConfirmar.Remove(c);
                Toast.Sucesso($"Conferência confirmada: {c.Equipamento}");
            }
            else
            {
                if (pos >= 0 && res.Aviso is not null) _porConfirmar[pos] = c with { Aviso = res.Aviso };
                _erro = res.Mensagem;
            }
        }
        catch (InvalidOperationException ex) { _erro = ex.Message; }
        catch (Exception) { _erro = "Não foi possível confirmar. Tente outra vez."; }
        finally { _ocupado = false; }
    }

    private async Task VerMaisAsync() { _limite += PorPagina; await CarregarMateriaisAsync(); }

    private Task DevolverAsync(Intervencao f) => AgirAsync(f, () => Intervencoes.DevolverAsync(f.Id, _motivo.Trim()), $"Devolvida ao técnico: {f.Equipamento}.");

    private async Task AgirAsync(Intervencao f, Func<Task<Intervencao>> acao, string sucesso)
    {
        _ocupado = true; _aviso = _erro = null;
        try
        {
            var resultado = await acao();
            _fichas.Remove(f);
            Toast.Sucesso(resultado.Pendente ? "Guardado. Será enviado quando houver rede." : sucesso);
        }
        catch (InvalidOperationException ex)
        {
            await CarregarAsync();
            _erro = ex.Message;
        }
        catch (Exception) { _erro = "Não foi possível guardar. Tente outra vez."; }
        finally { _ocupado = false; _aConfirmar = _aDevolver = null; }
    }
}
