@page "/validacao"
@inject SessaoService Sessao
@inject IIntervencoesService Intervencoes

<PageTitle>Validação · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="/"><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Validação</h1>
    </div>

    @if (!Sessao.PodeSerSupervisor)
    {
        <p class="estado-lista" role="status">Esta área é só para supervisores.</p>
    }
    else if (_a_carregar)
    {
        <p class="estado-lista" role="status">A carregar…</p>
    }
    else if (_indisponivel)
    {
        <p class="estado-lista" role="status">Esta parte ainda não está disponível.</p>
    }
    else if (_falhou)
    {
        <div class="estado-lista" role="alert">
            <p>Não foi possível carregar as fichas.</p>
            <button type="button" class="btn btn-secundario" @onclick="CarregarAsync">Tentar outra vez</button>
        </div>
    }
    else
    {
        @if (_aviso is not null)
        {
            <p class="alerta alerta-pin" role="status"><Icone Nome="circle-check" /><span>@_aviso</span></p>
        }
        @if (_erro is not null)
        {
            <p class="alerta" role="alert"><Icone Nome="triangle-alert" /><span>@_erro</span></p>
        }
        @if (_fichas.Count == 0)
        {
            <p class="estado-lista" role="status">Não há fichas por validar. Está tudo em dia!</p>
        }
        else
        {
            <h2 class="titulo-grupo">Por validar <span class="contagem">@_fichas.Count</span></h2>
            <ul class="lista-intervencoes">
                @foreach (var f in _fichas.Take(_limite))
                {
                    <li class="intervencao ficha-validar">
                        <span class="intervencao-titulo">@f.Equipamento</span>
                        <span class="intervencao-desc">@(string.IsNullOrWhiteSpace(f.Zona) ? "Sem zona" : f.Zona)@(f.Tecnico is null ? "" : " · " + f.Tecnico)</span>
                        <span class="chips">
                            <span class="chip chip-ok">Concluída</span>
                            <span class="chip @(f.Tipo == TipoIntervencao.Curativa ? "chip-aviso" : "")">@(f.Tipo == TipoIntervencao.Curativa ? "Avaria" : "Preventiva")</span>
                        </span>
                        <span class="intervencao-data">@f.DataPlaneada.ToString("dd/MM")</span>
                        @if (!string.IsNullOrWhiteSpace(f.Anomalia))
                        {
                            <p class="ficha-texto"><strong>Problema:</strong> @f.Anomalia</p>
                        }
                        <p class="ficha-texto"><strong>Feito:</strong> @(f.Feito ?? "—")@(f.HoraInicio is null || f.HoraFim is null ? "" : $" ({f.HoraInicio:HH\\:mm}–{f.HoraFim:HH\\:mm})")</p>
                        @if (!f.PodeValidar)
                        {
                            <p class="ficha-texto">Concluiu esta ficha: tem de ser outra pessoa a validar.</p>
                        }
                        else if (_aDevolver == f.Id)
                        {
                            <div class="campo ficha-texto">
                                <label for="motivo-@f.Id">Porque devolve?</label>
                                <textarea id="motivo-@f.Id" rows="2" maxlength="254" @bind="_motivo" @bind:event="oninput"></textarea>
                            </div>
                            <div class="ficha-acoes">
                                <button type="button" class="btn" disabled="@(_ocupado || string.IsNullOrWhiteSpace(_motivo))" @onclick="() => DevolverAsync(f)">
                                    <Icone Nome="rotate-ccw" /><span>Devolver</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => _aDevolver = null">Cancelar</button>
                            </div>
                        }
                        else if (_aConfirmar == f.Id)
                        {
                            <div class="ficha-acoes">
                                <button type="button" class="btn" disabled="@_ocupado" @onclick="() => ValidarAsync(f)">
                                    <Icone Nome="circle-check" /><span>Confirmar</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => _aConfirmar = null">Cancelar</button>
                            </div>
                        }
                        else
                        {
                            <div class="ficha-acoes">
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => { _aConfirmar = f.Id; _aDevolver = null; }">
                                    <Icone Nome="shield-check" /><span>Validar</span>
                                </button>
                                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="() => { _aDevolver = f.Id; _aConfirmar = null; _motivo = string.Empty; }">
                                    <Icone Nome="rotate-ccw" /><span>Devolver</span>
                                </button>
                            </div>
                        }
                    </li>
                }
            </ul>
            @if (_fichas.Count > _limite)
            {
                <button type="button" class="btn btn-secundario" @onclick="() => _limite += PorPagina">Ver mais (@(_fichas.Count - _limite))</button>
            }
        }
    }
</section>

@code {
    private List<Intervencao> _fichas = [];
    private bool _a_carregar = true, _falhou, _indisponivel, _ocupado;
    private string? _aConfirmar, _aDevolver, _aviso, _erro;
    private string _motivo = "";
    private const int PorPagina = 10;
    private int _limite = PorPagina;

    protected override async Task OnInitializedAsync()
    {
        if (Sessao.PodeSerSupervisor) await CarregarAsync();
        else _a_carregar = false;
    }

    private async Task CarregarAsync()
    {
        _a_carregar = true; _falhou = false; _indisponivel = false; _aConfirmar = _aDevolver = null;
        try { _fichas = (await Intervencoes.ListarPorValidarAsync()).ToList(); }
        catch (NotSupportedException) { _indisponivel = true; }
        catch (Exception) { _falhou = true; }
        finally { _a_carregar = false; }
    }

    private Task ValidarAsync(Intervencao f) => AgirAsync(f, () => Intervencoes.ValidarAsync(f.Id), $"Validada: {f.Equipamento}.");

    private Task DevolverAsync(Intervencao f) => AgirAsync(f, () => Intervencoes.DevolverAsync(f.Id, _motivo.Trim()), $"Devolvida ao técnico: {f.Equipamento}.");

    private async Task AgirAsync(Intervencao f, Func<Task<Intervencao>> acao, string sucesso)
    {
        _ocupado = true; _aviso = _erro = null;
        try
        {
            await acao();
            _fichas.Remove(f);
            _aviso = sucesso;
        }
        catch (InvalidOperationException ex)
        {
            await CarregarAsync();
            _erro = ex.Message;
        }
        catch (Exception) { _erro = "Não foi possível guardar. Tente outra vez."; }
        finally { _ocupado = false; _aConfirmar = _aDevolver = null; }
    }
}
