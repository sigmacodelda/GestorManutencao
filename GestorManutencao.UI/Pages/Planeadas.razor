@page "/planeadas"
@implements IDisposable
@inject SessaoService Sessao
@inject IIntervencoesService Intervencoes
@inject NotificacaoService Notificacoes
@inject IEquipaService ServicoEquipa
@inject GeracaoDiaria GeracaoDiariaServico

<PageTitle>Planeadas · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="/"><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Planeadas</h1>
    </div>

    @if (!Sessao.PodeSerSupervisor)
    {
        <p class="estado-lista" role="status">Esta área é só para supervisores.</p>
    }
    else if (_a_carregar)
    {
        <p class="estado-lista" role="status">A carregar…</p>
    }
    else if (_indisponivel)
    {
        <p class="estado-lista" role="status">Esta parte ainda não está disponível.</p>
    }
    else if (_falhou)
    {
        <div class="estado-lista" role="alert">
            <p>Não foi possível carregar as planeadas.</p>
            <button type="button" class="btn btn-secundario" @onclick="CarregarAsync">Tentar outra vez</button>
        </div>
    }
    else
    {
        @if (_avisoGeracao is not null)
        {
            <p class="ficha-texto" role="status">@_avisoGeracao</p>
        }
        @if (_aviso is not null)
        {
            <p class="alerta alerta-pin" role="status"><Icone Nome="circle-check" /><span>@_aviso</span></p>
        }
        @if (_erro is not null)
        {
            <p class="alerta" role="alert"><Icone Nome="triangle-alert" /><span>@_erro</span></p>
        }
        @if (_fichas.Count == 0)
        {
            <p class="estado-lista" role="status">Não há intervenções planeadas.</p>
        }
        else
        {
            var t = VistaPlaneadas.Contar(_fichas, _hoje, _antecedencia);
            <ul class="contadores contadores-4" aria-label="Resumo das planeadas (toque para filtrar)">
                <li><button type="button" class="contador contador-btn @(_kpi == KpiPlaneadas.EmAberto ? "contador-ativo" : "")" aria-pressed="@(_kpi == KpiPlaneadas.EmAberto ? "true" : "false")" @onclick="() => Filtrar(KpiPlaneadas.EmAberto)"><span class="led" aria-hidden="true"></span><span class="contador-num">@t.EmAberto</span><span class="contador-rot">Em aberto</span></button></li>
                <li><button type="button" class="contador contador-btn @(t.ForaDePrazo > 0 ? "alerta-led" : "") @(_kpi == KpiPlaneadas.ForaDePrazo ? "contador-ativo" : "")" aria-pressed="@(_kpi == KpiPlaneadas.ForaDePrazo ? "true" : "false")" @onclick="() => Filtrar(KpiPlaneadas.ForaDePrazo)"><span class="led" aria-hidden="true"></span><span class="contador-num">@t.ForaDePrazo</span><span class="contador-rot">Fora de prazo</span></button></li>
                <li><button type="button" class="contador contador-btn @(_kpi == KpiPlaneadas.AVencer ? "contador-ativo" : "")" aria-pressed="@(_kpi == KpiPlaneadas.AVencer ? "true" : "false")" @onclick="() => Filtrar(KpiPlaneadas.AVencer)"><span class="led" aria-hidden="true"></span><span class="contador-num">@t.AVencer</span><span class="contador-rot">A vencer (@_antecedencia dias)</span></button></li>
                <li><button type="button" class="contador contador-btn @(_kpi == KpiPlaneadas.EmCurso ? "contador-ativo" : "")" aria-pressed="@(_kpi == KpiPlaneadas.EmCurso ? "true" : "false")" @onclick="() => Filtrar(KpiPlaneadas.EmCurso)"><span class="led" aria-hidden="true"></span><span class="contador-num">@t.EmCurso</span><span class="contador-rot">Em curso</span></button></li>
            </ul>
            <div class="filtros">
                <div class="campo">
                    <label for="pl-zona">Zona</label>
                    <select id="pl-zona" @bind="_zona">
                        <option value="">Todas</option>
                        @foreach (var z in VistaPlaneadas.Zonas(_fichas)) { <option value="@z">@z</option> }
                    </select>
                </div>
                <div class="campo">
                    <label for="pl-texto">Pesquisar</label>
                    <input id="pl-texto" type="search" autocomplete="off" maxlength="@RegrasPesquisa.MaxTexto" placeholder="Equipamento, técnico ou problema" @bind="_texto" @bind:event="oninput" />
                </div>
            </div>
            @if (Filtradas().Count == 0)
            {
                <p class="estado-lista" role="status">Não há intervenções com estes filtros.</p>
            }
        }
        @foreach (var zona in Zonas())
        {
            <section aria-labelledby="@IdZona(zona.Nome)">
                <h2 id="@IdZona(zona.Nome)" class="titulo-grupo">@zona.Nome <span class="contagem">@zona.Itens.Count</span></h2>
                <ul class="lista-intervencoes">
                    @foreach (var f in zona.Itens.Take(Limite(zona.Nome)))
                    {
                        var foraDePrazo = f.ForaDePrazo(_hoje);
                        var atrasada = f.EstaAtrasada(_hoje) || foraDePrazo;
                        <li class="intervencao @(atrasada ? "atrasada" : "")">
                            <span class="intervencao-titulo">@f.Equipamento</span>
                            <span class="intervencao-desc">@(f.Tecno == 0 ? "Sem técnico" : f.Tecnico ?? "PHC " + f.Tecno)@(f.OutrosTecnicos.Count > 0 ? " + " + string.Join(", ", f.OutrosTecnicos.Select(a => a.Nome)) : "")</span>
                            <span class="chips">
                                @if (foraDePrazo) { <span class="chip chip-erro">Fora de prazo</span> }
                                else if (atrasada) { <span class="chip chip-erro">Atrasada</span> }
                                @if (f.Estado == EstadoIntervencao.EmCurso) { <span class="chip chip-curso">Em curso</span> }
                                <span class="chip @(f.Tipo == TipoIntervencao.Curativa ? "chip-aviso" : "")">@(f.Tipo == TipoIntervencao.Curativa ? "Avaria" : "Preventiva")</span>
                            </span>
                            <span class="intervencao-data">@TextoData(f.DataPlaneada)</span>
                            <p class="ficha-texto">
                                @if (f.UltimaIntervencao is { } ultima) { <span>Última intervenção: @ultima.ToString("dd/MM/yyyy")</span> }
                                else { <span>Última intervenção: sem registo</span> }
                                @if (f.UltimaCancelada is { } cancelada && (f.UltimaIntervencao is null || cancelada > f.UltimaIntervencao)) { <span> · Cancelada a @cancelada.ToString("dd/MM/yyyy")</span> }
                            </p>
                            @if (foraDePrazo)
                            {
                                <p class="ficha-texto"><strong>Fora de prazo desde @f.DataPrevista!.Value.ToString("dd/MM/yyyy")</strong></p>
                            }
                            <div class="campo ficha-texto">
                                <label for="tec-@f.Id">Técnico</label>
                                <select id="tec-@f.Id" disabled="@_ocupado" value="@f.Tecno" @onchange="e => AtribuirAsync(f, e.Value?.ToString())">
                                    <option value="0">Sem técnico</option>
                                    @if (f.Tecno > 0 && !_tecnicos.Any(t => t.Tecno == f.Tecno))
                                    {
                                        <option value="@f.Tecno" disabled>@(f.Tecnico ?? "PHC " + f.Tecno)</option>
                                    }
                                    @foreach (var t in _tecnicos)
                                    {
                                        <option value="@t.Tecno">@t.Nome</option>
                                    }
                                </select>
                            </div>
                            @if (f.Tecno > 0)
                            {
                                <details class="filtros-bloco ficha-texto">
                                    <summary>Outros técnicos@(f.OutrosTecnicos.Count > 0 ? $" ({f.OutrosTecnicos.Count})" : "")</summary>
                                    <div class="filtros">
                                        @foreach (var a in f.OutrosTecnicos.Where(a => !_tecnicos.Any(t => t.Tecno == a.Tecno)))
                                        {
                                            <label class="opcao-caixa" for="adic-@f.Id-@a.Tecno">
                                                <input id="adic-@f.Id-@a.Tecno" type="checkbox" disabled="@_ocupado" checked="true"
                                                       @onchange="e => AlternarAdicionalAsync(f, a.Tecno, e.Value is true)" />
                                                <span>@a.Nome</span>
                                            </label>
                                        }
                                        @foreach (var t in _tecnicos.Where(t => t.Tecno != f.Tecno))
                                        {
                                            <label class="opcao-caixa" for="adic-@f.Id-@t.Tecno">
                                                <input id="adic-@f.Id-@t.Tecno" type="checkbox" disabled="@_ocupado" checked="@f.OutrosTecnicos.Any(a => a.Tecno == t.Tecno)"
                                                       @onchange="e => AlternarAdicionalAsync(f, t.Tecno, e.Value is true)" />
                                                <span>@t.Nome</span>
                                            </label>
                                        }
                                    </div>
                                </details>
                            }
                        </li>
                    }
                </ul>
                @if (zona.Itens.Count > Limite(zona.Nome))
                {
                    <button type="button" class="btn btn-secundario" @onclick="() => _limites[zona.Nome] = Limite(zona.Nome) + PorPagina">
                        Ver mais (@(zona.Itens.Count - Limite(zona.Nome)))
                    </button>
                }
            </section>
        }
    }
</section>

@code {
    private sealed record GrupoZona(string Nome, IReadOnlyList<Intervencao> Itens);

    private List<Intervencao> _fichas = [];
    private IReadOnlyList<MembroEquipa> _tecnicos = [];
    private bool _a_carregar = true, _falhou, _indisponivel, _ocupado;
    private string? _aviso, _erro;
    private DateOnly _hoje;
    private const int PorPagina = 10;
    private readonly Dictionary<string, int> _limites = [];

    private int Limite(string zona) => _limites.GetValueOrDefault(zona, PorPagina);

    protected override async Task OnInitializedAsync()
    {
        if (!Sessao.PodeSerSupervisor) { _a_carregar = false; return; }
        await CarregarAsync();
        if (!_falhou && !_indisponivel) await GerarDoDiaAsync();
    }

    // Uma vez por dia (por dispositivo e utilizador) gera as planeadas ao abrir o ecrã; sem rede ou com falha só fica um aviso discreto.
    private async Task GerarDoDiaAsync()
    {
        var utilizador = Sessao.Utilizador?.Nome ?? "";
        var r = await GeracaoDiariaServico.ExecutarAsync(utilizador, _gerarPlaneadas, () => Intervencoes.GerarPlaneadasAsync());
        _avisoGeracao = r.Aviso;
        if (r.Criadas > 0)
        {
            _aviso = $"Geradas {r.Criadas} planeadas de hoje.";
            await CarregarAsync();
        }
    }

    private async Task CarregarAsync()
    {
        _a_carregar = true; _falhou = false; _indisponivel = false;
        _hoje = DateOnly.FromDateTime(DateTime.Today);
        try
        {
            _fichas = (await Intervencoes.ListarPlaneadasAsync()).ToList();
            try
            {
                var cfg = await Intervencoes.ObterConfiguracaoAsync();
                _antecedencia = cfg.Antecedencia; _gerarPlaneadas = cfg.GerarPlaneadas;
            }
            catch (Exception) { _antecedencia = 7; _gerarPlaneadas = false; }
            // Só quem tem número do PHC pode ter fichas.
            _tecnicos = (await ServicoEquipa.ListarAsync(Sessao.Utilizador?.Token)).Where(m => m.Ativo && m.Tecno > 0).OrderBy(m => m.Nome).ToList();
        }
        catch (NotSupportedException) { _indisponivel = true; }
        catch (Exception) { _falhou = true; }
        finally { _a_carregar = false; }
    }

    // O servidor avisa que as fichas mudaram: recarrega logo, salvo se o supervisor estiver a meio de uma ação.
    private void AoMudarDados() => InvokeAsync(async () => { if (!Sessao.PodeSerSupervisor || _ocupado) return; await CarregarAsync(); StateHasChanged(); });

    public void Dispose() => Notificacoes.DadosMudaram -= AoMudarDados;

    private bool _gerarPlaneadas;
    private string? _avisoGeracao;
    private KpiPlaneadas _kpi;
    private string _zona = "", _texto = "";
    private int _antecedencia = 7;

    // Tocar outra vez no mesmo indicador tira o filtro.
    private void Filtrar(KpiPlaneadas kpi) { _kpi = _kpi == kpi ? KpiPlaneadas.Nenhum : kpi; _limites.Clear(); }

    private IReadOnlyList<Intervencao> Filtradas() => VistaPlaneadas.Filtrar(_fichas, _kpi, _zona, _texto, _hoje, _antecedencia);

    private IEnumerable<GrupoZona> Zonas() => Filtradas()
        .GroupBy(f => string.IsNullOrWhiteSpace(f.Zona) ? "Sem zona" : f.Zona)
        .OrderBy(g => g.Key == "Sem zona" ? 1 : 0).ThenBy(g => g.Key)
        .Select(g => new GrupoZona(g.Key, g.OrderBy(f => f.DataPlaneada).ToList()));

    private static string IdZona(string zona) => "zona-" + new string(zona.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());

    private async Task AtribuirAsync(Intervencao f, string? valor)
    {
        if (!int.TryParse(valor, out var tecno) || tecno == f.Tecno) return;
        _ocupado = true; _aviso = _erro = null;
        try
        {
            var nova = await Intervencoes.AtribuirAsync(f.Id, tecno);
            var pos = _fichas.FindIndex(x => x.Id == f.Id);
            if (pos >= 0) _fichas[pos] = nova;
            _aviso = tecno == 0 ? $"{f.Equipamento}: sem técnico." : $"{f.Equipamento}: atribuída a {nova.Tecnico}.";
        }
        catch (InvalidOperationException ex)
        {
            await CarregarAsync();
            _erro = ex.Message;
        }
        catch (Exception) { _erro = "Não foi possível guardar. Tente outra vez."; }
        finally { _ocupado = false; }
    }

    private async Task AlternarAdicionalAsync(Intervencao f, int tecno, bool marcado)
    {
        _ocupado = true; _aviso = _erro = null;
        try
        {
            var novos = f.OutrosTecnicos.Select(a => a.Tecno).Where(t => t != tecno).ToList();
            if (marcado) novos.Add(tecno);
            var nova = await Intervencoes.DefinirAdicionaisAsync(f.Id, novos);
            var pos = _fichas.FindIndex(x => x.Id == f.Id);
            if (pos >= 0) _fichas[pos] = nova;
            _aviso = $"{f.Equipamento}: técnicos atualizados.";
        }
        catch (InvalidOperationException ex)
        {
            await CarregarAsync();
            _erro = ex.Message;
        }
        catch (Exception)
        {
            await CarregarAsync();
            _erro = "Não foi possível guardar. Tente outra vez.";
        }
        finally { _ocupado = false; }
    }

    private string TextoData(DateOnly d)
    {
        var dias = d.DayNumber - _hoje.DayNumber;
        return dias switch
        {
            0 => "Hoje",
            1 => "Amanhã",
            -1 => "Ontem",
            < 0 => $"Há {-dias} dias",
            _ => $"Dia {d:dd/MM}"
        };
    }
}
