@page "/"
@implements IDisposable
@inject SessaoService Sessao
@inject IIntervencoesService Intervencoes
@inject NotificacaoService Notificacoes
@inject IGestorOffline Offline
@inject NavigationManager Nav

<PageTitle>Início · Gestor de Manutenção</PageTitle>

@if (Sessao.TemSessao)
{
    var supervisor = Sessao.Modo == ModoTrabalho.Supervisor;
    <section class="conteudo">
        <div class="boas-vindas hero">
            <Engrenagem Classe="engr-hero" />
            <div class="hero-acoes">
                <ModoVisual />
                <button type="button" class="btn-icone" aria-label="Terminar sessão" @onclick="Sair">
                    <Icone Nome="log-out" />
                </button>
            </div>
            <div class="hero-texto">
                <p class="sobretitulo">@(supervisor ? "Supervisor" : "Operador")</p>
                <h1>@Saudacao(), @PrimeiroNome</h1>
                <p class="hero-utilizador">
                    <span class="avatar" aria-hidden="true">@Sessao.Utilizador!.Iniciais</span>
                    <span>@Sessao.Utilizador.Nome</span>
                </p>
                <p class="hero-data">@DataExtenso()</p>
            </div>
        </div>

        @if (_contadores is { Count: > 0 } || Offline.Pendentes > 0 || Offline.Conflitos > 0)
        {
            <ul class="contadores" aria-label="Resumo">
                @foreach (var c in Contadores())
                {
                    <li>
                        <a class="contador @(c.Alerta && c.Valor > 0 ? "alerta-led" : "")" href="@c.Href">
                            <span class="led" aria-hidden="true"></span>
                            <span class="contador-num">@c.Valor</span>
                            <span class="contador-rot">@c.Rotulo</span>
                        </a>
                    </li>
                }
            </ul>
        }

        @if (Sessao.PodeSerSupervisor)
        {
            <div class="segmentos" role="group" aria-label="Modo de trabalho">
                <button type="button" class="segmento" aria-pressed="@((!supervisor).ToString().ToLowerInvariant())"
                        @onclick="() => Mudar(ModoTrabalho.Operador)">
                    <Icone Nome="wrench" /><span>Operador</span>
                </button>
                <button type="button" class="segmento" aria-pressed="@supervisor.ToString().ToLowerInvariant()"
                        @onclick="() => Mudar(ModoTrabalho.Supervisor)">
                    <Icone Nome="users" /><span>Supervisor</span>
                </button>
            </div>
        }

        <ul class="mosaicos">
            @if (supervisor)
            {
                <Mosaico Icone="calendar" Titulo="Planeadas" Href="planeadas" Descricao="Intervenções por atribuir e em atraso" Contagem="_menu?.PlaneadasAtrasadas ?? 0" RotuloContagem="em atraso" />
                <Mosaico Icone="shield-check" Titulo="Validação" Href="validacao" Descricao="Fichas concluídas a validar" Contagem="_menu?.PorValidar ?? 0" RotuloContagem="por validar" />
                <Mosaico Icone="plus" Titulo="Nova ficha" Href="nova-ficha" Descricao="Criar uma ficha de intervenção" />
                <Mosaico Icone="factory" Titulo="Equipamentos" Href="equipamentos" Descricao="Fichas, histórico e instruções de cada equipamento" />
                <Mosaico Icone="plus" Titulo="Novo equipamento" Href="equipamentos/novo" Descricao="Registar um equipamento novo" />
                <Mosaico Icone="clock" Titulo="Periodicidades" Href="periodicidades" Descricao="Unidade, intervalo e aviso" />
                <Mosaico Icone="list" Titulo="Todas as fichas" Href="fichas" Descricao="Pesquisar fichas de qualquer estado" />
                <Mosaico Icone="users" Titulo="Equipa" Href="equipa" Descricao="Utilizadores e PINs" />
                <Mosaico Icone="settings" Titulo="Configuração" Href="configuracao" Descricao="Regras da manutenção" />
            }
            else
            {
                <Mosaico Icone="clipboard-list" Titulo="As minhas intervenções" Href="intervencoes" Descricao="O que tenho para fazer hoje" />
                <Mosaico Icone="triangle-alert" Titulo="Registar avaria" Href="avaria" Descricao="Avisar de um problema no equipamento" />
                <Mosaico Icone="factory" Titulo="Equipamentos" Href="equipamentos" Descricao="Consultar fichas e histórico" />
            }
            <Mosaico Icone="bell" Titulo="Notificações" Href="notificacoes" Contagem="Notificacoes.NaoLidas"
                     Descricao="@(Notificacoes.NaoLidas > 0 ? "Tem avisos novos" : "Sem avisos novos")" />
        </ul>
        @if (_pendentesSaida > 0)
        {
            <ConfirmaSaida Pendentes="_pendentesSaida" Sair="TerminarSessaoAsync" Ficar="() => _pendentesSaida = 0" />
        }
    </section>
}

@code {
    private sealed record Contador(string Rotulo, int Valor, string Href, bool Alerta = false);
    private List<Contador>? _contadores;
    private ContadoresMenu? _menu;
    private int _pendentesSaida;

    protected override async Task OnInitializedAsync()
    {
        Notificacoes.Alterado += Atualizar;
        Offline.Mudou += Atualizar;
        if (Sessao.TemSessao) await CarregarAsync();
    }

    private void Atualizar() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Notificacoes.Alterado -= Atualizar;
        Offline.Mudou -= Atualizar;
    }

    // Os resumos do dia mais o que ficou por enviar e por rever neste telemóvel.
    private IEnumerable<Contador> Contadores()
    {
        foreach (var c in _contadores ?? []) yield return c;
        if (Offline.Pendentes > 0) yield return new("Por enviar", Offline.Pendentes, "intervencoes");
        if (Offline.Conflitos > 0) yield return new("Por rever", Offline.Conflitos, "por-rever", true);
    }

    // Com registos por enviar pede confirmação; a fila fica guardada e segue quando o mesmo utilizador voltar a entrar.
    private async Task Sair()
    {
        var pendentes = await Offline.ContarPendentesAsync();
        if (pendentes > 0) { _pendentesSaida = pendentes; return; }
        await TerminarSessaoAsync();
    }

    private async Task TerminarSessaoAsync()
    {
        _pendentesSaida = 0;
        await Sessao.SairAsync();
        Nav.NavigateTo("login", replace: true);
    }

    private async Task Mudar(ModoTrabalho modo) { Sessao.MudarModo(modo); await CarregarAsync(); }

    // Resumo do dia; se o serviço não responde, simplesmente não aparece.
    private async Task CarregarAsync()
    {
        try
        {
            var hoje = DateOnly.FromDateTime(DateTime.Now);
            _menu = null;
            if (Sessao.Modo == ModoTrabalho.Supervisor)
            {
                // Endpoint leve; sem rede ou com erro, o resumo simplesmente não aparece.
                _menu = await Intervencoes.ObterContadoresAsync();
                _contadores = ContadoresInicio.Supervisor(_menu).Select(l => new Contador(l.Rotulo, l.Valor, l.Href, l.Alerta)).ToList();
            }
            else
            {
                var minhas = await Intervencoes.ListarMinhasAsync();
                _contadores =
                [
                    new("Em curso", minhas.Count(i => i.Estado == EstadoIntervencao.EmCurso), "intervencoes"),
                    new("Atrasadas", minhas.Count(i => i.EstaAtrasada(hoje)), "intervencoes", true),
                    new("Para fazer", minhas.Count(i => i.PorFazer), "intervencoes")
                ];
            }
        }
        catch (Exception) { _contadores = null; }
    }

    private static string DataExtenso()
    {
        var s = DateTime.Now.ToString("dddd, d 'de' MMMM", new System.Globalization.CultureInfo("pt-PT"));
        return char.ToUpperInvariant(s[0]) + s[1..];
    }
    private string PrimeiroNome => Sessao.Utilizador!.Nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    private static string Saudacao() => DateTime.Now.Hour switch
    {
        < 12 => "Bom dia",
        < 20 => "Boa tarde",
        _ => "Boa noite"
    };
}
