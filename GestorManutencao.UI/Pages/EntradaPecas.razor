@page "/pecas/entrada"
@inject IPecasService Pecas
@implements IDisposable
@inject IRedeEstado Rede
@inject SessaoService Sessao

<PageTitle>Entrada de peças · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="/"><Icone Nome="arrow-left" /><span>Início</span></a>
        <h1 tabindex="-1">Entrada de peças</h1>
    </div>

    @if (Sessao.EQualidade)
    {
        <p class="estado-lista" role="status">Esta área não é para o seu perfil.</p>
        return;
    }

    @if (!Rede.Disponivel)
    {
        <p class="alerta" role="status"><Icone Nome="triangle-alert" /><span>Sem ligação: a entrada de peças precisa de rede.</span></p>
    }

    @if (_peca is null)
    {
        <PecaPesquisa @ref="_pesquisa" OnEscolher="Escolher" />
    }
    else
    {
        <form class="pesquisa" @onsubmit="DarEntradaAsync" novalidate>
            <p class="intervencao-titulo">@_peca.Ref @_peca.Design</p>
            <p class="intervencao-desc">Stock @_peca.Stock.ToString("0.###") · @(_peca.Local.Length > 0 ? _peca.Local : "Sem local")</p>
            <div class="campo">
                <label for="peca-qtt">Quantidade</label>
                <input id="peca-qtt" type="number" min="0.001" step="any" inputmode="decimal" @ref="_campoQtt" @bind="_qtt" />
            </div>
            <div class="dialogo-acoes">
                <button type="submit" class="btn btn-primario" disabled="@(!Rede.Disponivel || _a_gravar)">Dar entrada</button>
                <button type="button" class="btn btn-secundario" @onclick="Cancelar">Cancelar</button>
            </div>
        </form>
    }
    <p class="campo-erro" role="alert">@_erro</p>
    @if (_feito.Length > 0)
    {
        <p class="estado-lista" role="status">@_feito</p>
    }

    <h2>Entradas de hoje</h2>
    @if (_entradas is null)
    {
        <p class="estado-lista" role="status">A carregar…</p>
    }
    else if (_entradas.Count == 0)
    {
        <p class="estado-lista" role="status">Ainda não há entradas hoje.</p>
    }
    else
    {
        <ul class="lista-intervencoes">
            @foreach (var e in _entradas)
            {
                <li class="intervencao">
                    <span class="intervencao-titulo">@e.Hora · @e.Ref @e.Design</span>
                    <span class="intervencao-desc">@e.Qtt.ToString("0.###") · @e.Quem</span>
                    <button type="button" class="btn btn-secundario" disabled="@(!Rede.Disponivel || _a_gravar)" @onclick="() => _paraAnular = e">Anular</button>
                </li>
            }
        </ul>
    }

    @if (_paraAnular is { } a)
    {
        <ConfirmaSaida Titulo="Anular entrada?" Texto="@($"Vai anular a entrada de {a.Qtt:0.###} de {a.Ref} {a.Design}. O stock volta ao valor anterior.")"
                       TextoSair="Anular" TextoFicar="Manter" Sair="AnularAsync" Ficar="() => _paraAnular = null" />
    }
</section>

@code {
    private Peca? _peca;
    private decimal? _qtt = 1;
    private string _erro = "", _feito = "";
    private bool _a_gravar, _focarQtt, _focarPesquisa;
    private IReadOnlyList<EntradaPeca>? _entradas;
    private EntradaPeca? _paraAnular;
    private PecaPesquisa? _pesquisa;
    private ElementReference _campoQtt;

    protected override async Task OnInitializedAsync()
    {
        Rede.Alterada += AoMudarRede;
        if (!Sessao.EQualidade) await CarregarEntradasAsync();
    }

    public void Dispose() => Rede.Alterada -= AoMudarRede;

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (_focarQtt) { _focarQtt = false; await _campoQtt.FocusAsync(); }
        else if (_focarPesquisa && _pesquisa is not null) { _focarPesquisa = false; await _pesquisa.FocarAsync(); }
    }

    private void AoMudarRede(bool disponivel) => _ = InvokeAsync(async () =>
    {
        if (disponivel && !Sessao.EQualidade) await CarregarEntradasAsync();
        StateHasChanged();
    });

    private void Escolher(Peca p) { _peca = p; _qtt = 1; _erro = ""; _feito = ""; _focarQtt = true; }

    private void Cancelar() { _peca = null; _erro = ""; _focarPesquisa = true; }

    private async Task CarregarEntradasAsync()
    {
        try { _entradas = await Pecas.EntradasDeHojeAsync(); }
        catch (Exception e) { _entradas ??= []; _erro = MensagensGestao.Para(e, "Não foi possível carregar as entradas de hoje."); }
    }

    // Sem resposta (rede, timeout, 5xx) não se sabe se a entrada ficou gravada.
    private static bool ResultadoIncerto(Exception e) =>
        e is FalhaDeRedePecasException or TaskCanceledException
        || e is HttpRequestException { StatusCode: not System.Net.HttpStatusCode.Unauthorized };

    private async Task DarEntradaAsync()
    {
        if (_peca is null || _a_gravar) return;
        _erro = "";
        if (LogicaEcraPecas.ValidarQuantidade(_qtt) is { } invalida) { _erro = invalida; return; }
        _a_gravar = true;
        try
        {
            var e = await Pecas.DarEntradaAsync(_peca.Ref, _qtt!.Value);
            _feito = $"Entrada dada: {e.Qtt:0.###} de {e.Ref} {e.Design}.";
            _peca = null;
            _focarPesquisa = true;
            await CarregarEntradasAsync();
        }
        catch (Exception e) when (ResultadoIncerto(e))
        {
            await CarregarEntradasAsync();
            _erro = "Confirme na lista de hoje antes de repetir a entrada.";
        }
        catch (Exception e) { _erro = MensagensGestao.Para(e, "Não foi possível dar a entrada."); }
        finally { _a_gravar = false; }
    }

    private async Task AnularAsync()
    {
        var a = _paraAnular;
        _paraAnular = null;
        if (a is null) return;
        _erro = ""; _feito = "";
        _a_gravar = true;
        try
        {
            await Pecas.AnularEntradaAsync(a.Id);
            _feito = $"Entrada anulada: {a.Qtt:0.###} de {a.Ref}.";
            await CarregarEntradasAsync();
        }
        catch (Exception e) { _erro = MensagensGestao.Para(e, "Não foi possível anular. Tente outra vez."); }
        finally { _a_gravar = false; }
    }
}
