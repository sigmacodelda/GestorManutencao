@page "/fichas"
@inject SessaoService Sessao
@inject IIntervencoesService Intervencoes
@inject IEquipaService ServicoEquipa

<PageTitle>Todas as fichas · Gestor de Manutenção</PageTitle>

<section class="conteudo">
    <div class="boas-vindas">
        <a class="voltar" href="mais"><Icone Nome="arrow-left" /><span>Mais</span></a>
        <h1 tabindex="-1">Todas as fichas</h1>
    </div>

    @if (!Sessao.PodeSerSupervisor)
    {
        <p class="estado-lista" role="status">Esta área é só para supervisores.</p>
    }
    else if (_indisponivel)
    {
        <p class="estado-lista" role="status">Esta parte ainda não está disponível.</p>
    }
    else
    {
        <form class="pesquisa" role="search" @onsubmit="PesquisarAsync" novalidate>
            <div class="segmentos" role="group" aria-label="Situação das fichas">
                @foreach (var s in Situacoes)
                {
                    <button type="button" class="segmento" aria-pressed="@((_situacao == s).ToString().ToLowerInvariant())" @onclick="() => MudarSituacaoAsync(s)">
                        <span>@VistaFichas.Rotulo(s)</span>
                    </button>
                }
            </div>
            <div class="pesquisa-linha">
                <div class="campo">
                    <label for="fi-texto">Pesquisar</label>
                    <input id="fi-texto" type="search" autocomplete="off" maxlength="@RegrasPesquisa.MaxTexto" placeholder="Nº, referência, equipamento ou problema"
                           aria-describedby="fi-erro" @bind="_texto" @bind:event="oninput" />
                </div>
                <button type="submit" class="btn btn-secundario" disabled="@_ocupado" aria-label="Pesquisar"><Icone Nome="search" /></button>
            </div>
            <details class="filtros-bloco">
                <summary>Filtros@(Ativos > 0 ? $" ({Ativos})" : "")</summary>
                <div class="filtros">
                    <div class="campo">
                        <label for="fi-estado">Estado</label>
                        <select id="fi-estado" @bind="_estado">
                            <option value="">Todos</option>
                            @foreach (var e in Estados)
                            {
                                <option value="@e">@ApresentacaoIntervencao.Estado(e)</option>
                            }
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fi-tipo">Tipo</label>
                        <select id="fi-tipo" @bind="_tipo">
                            <option value="">Todos</option>
                            <option value="@TipoIntervencao.Preventiva">Preventiva</option>
                            <option value="@TipoIntervencao.Curativa">Avaria</option>
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fi-tecnico">Técnico</label>
                        <select id="fi-tecnico" @bind="_tecno">
                            <option value="0">Todos</option>
                            @foreach (var t in _tecnicos) { <option value="@t.Tecno">@t.Nome</option> }
                        </select>
                    </div>
                    <div class="campo">
                        <label for="fi-desde">Desde</label>
                        <input id="fi-desde" type="date" min="1900-01-01" max="2999-12-31" @bind="_desde" />
                    </div>
                    <div class="campo">
                        <label for="fi-ate">Até</label>
                        <input id="fi-ate" type="date" min="1900-01-01" max="2999-12-31" @bind="_ate" />
                    </div>
                    <label class="opcao-caixa" for="fi-sup">
                        <input id="fi-sup" type="checkbox" @bind="_soPorSupervisionar" />
                        <span>Só por supervisionar</span>
                    </label>
                    <div class="campo">
                        <label for="fi-ordem">Ordenar por</label>
                        <select id="fi-ordem" @bind="_ordem">
                            @foreach (var o in Ordens) { <option value="@o">@VistaFichas.Rotulo(o)</option> }
                        </select>
                    </div>
                    <label class="opcao-caixa" for="fi-desc">
                        <input id="fi-desc" type="checkbox" @bind="_descendente" />
                        <span>Do maior para o menor</span>
                    </label>
                </div>
                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="PesquisarAsync">Aplicar filtros</button>
                <button type="button" class="btn-texto" @onclick="LimparAsync">Repor filtros</button>
            </details>
        </form>
        <p id="fi-erro" class="campo-erro" role="alert">@_erro</p>

        @if (_a_carregar)
        {
            <p class="estado-lista" role="status">A carregar…</p>
        }
        else if (_falhou)
        {
            <div class="estado-lista" role="alert">
                <p>Não foi possível carregar as fichas.</p>
                <button type="button" class="btn btn-secundario" @onclick="PesquisarAsync">Tentar outra vez</button>
            </div>
        }
        else if (_fichas.Count == 0)
        {
            <p class="estado-lista" role="status">Não há fichas com estes filtros.</p>
        }
        else
        {
            <ul class="lista-intervencoes">
                @foreach (var i in _fichas)
                {
                    <FichaCartao Ficha="i" MostrarEquipamento="true" Detalhada="true" Hoje="_hoje" @key="i.Id" />
                }
            </ul>
            @if (_temMais)
            {
                <p class="alerta" role="status"><Icone Nome="triangle-alert" /><span>Há mais fichas. Veja mais ou refine os filtros.</span></p>
                <button type="button" class="btn btn-secundario" disabled="@_ocupado" @onclick="VerMaisAsync">Ver mais</button>
            }
        }
    }
</section>

@code {
    private static readonly EstadoIntervencao[] Estados = Enum.GetValues<EstadoIntervencao>();
    private static readonly SituacaoFichas[] Situacoes = Enum.GetValues<SituacaoFichas>();
    private static readonly OrdemFichas[] Ordens = Enum.GetValues<OrdemFichas>();

    private List<Intervencao> _fichas = [];
    private IReadOnlyList<MembroEquipa> _tecnicos = [];
    private string _texto = "", _erro = "";
    private EstadoIntervencao? _estado;
    private TipoIntervencao? _tipo;
    private SituacaoFichas _situacao = SituacaoFichas.Abertas;
    private OrdemFichas _ordem = OrdemFichas.Data;
    private bool _descendente = true, _soPorSupervisionar;
    private DateOnly? _desde, _ate;
    private DateOnly _hoje = DateOnly.FromDateTime(DateTime.Today);
    private int _tecno, _pagina = 1;
    private bool _a_carregar = true, _falhou, _indisponivel, _ocupado, _temMais;

    protected override async Task OnInitializedAsync()
    {
        if (!Sessao.PodeSerSupervisor) return;
        (_desde, _ate) = IntervaloOmissao();
        try { _tecnicos = (await ServicoEquipa.ListarAsync(Sessao.Utilizador?.Token)).Where(m => m.Tecno > 0).OrderBy(m => m.Nome).ToList(); }
        catch (Exception) { /* sem a lista de técnicos o filtro fica só em "Todos" */ }
        await PesquisarAsync();
    }

    private (DateOnly?, DateOnly?) IntervaloOmissao(SituacaoFichas? situacao = null)
    {
        _hoje = DateOnly.FromDateTime(DateTime.Today);
        var (d, a) = VistaFichas.IntervaloOmissao(_hoje, situacao ?? _situacao);
        return (d, a);
    }

    private int Ativos => (_estado is null ? 0 : 1) + (_tipo is null ? 0 : 1) + (_tecno > 0 ? 1 : 0) + (_soPorSupervisionar ? 1 : 0)
        + (_ordem != OrdemFichas.Data || !_descendente ? 1 : 0) + ((_desde, _ate) == IntervaloOmissao() ? 0 : 1);

    private FiltroFichas Filtro() => new(_estado, _desde, _ate, _texto.Trim(), _tecno, _situacao, _soPorSupervisionar, _tipo, _ordem, _descendente);

    // Os filtros da última pesquisa: "Ver mais" continua essa pesquisa, mesmo que se tenha mexido nos campos sem aplicar.
    private FiltroFichas? _aplicado;

    // Se as datas ainda são as da omissão, acompanham a nova situação (nas abertas não há data final).
    private async Task MudarSituacaoAsync(SituacaoFichas s)
    {
        if ((_desde, _ate) == IntervaloOmissao()) (_desde, _ate) = IntervaloOmissao(s);
        _situacao = s;
        await PesquisarAsync();
    }

    private async Task LimparAsync()
    {
        _estado = null; _tipo = null; _tecno = 0; _soPorSupervisionar = false; _ordem = OrdemFichas.Data; _descendente = true; _texto = "";
        (_desde, _ate) = IntervaloOmissao();
        await PesquisarAsync();
    }

    private async Task PesquisarAsync()
    {
        _erro = VistaFichas.Validar(Filtro()) ?? "";
        if (_erro.Length > 0) return;
        _pagina = 1;
        _ocupado = true; _falhou = false;
        try
        {
            var filtro = Filtro();
            var p = await Intervencoes.ListarTodasAsync(filtro, _pagina);
            _aplicado = filtro;
            _fichas = p.Itens.Select(i => i with { PodeAbrir = true }).ToList();
            _temMais = p.TemMais;
        }
        catch (NotSupportedException) { _indisponivel = true; }
        catch (Exception) { _falhou = true; }
        finally { _a_carregar = false; _ocupado = false; }
    }

    private async Task VerMaisAsync()
    {
        _ocupado = true; _erro = "";
        try
        {
            var p = await Intervencoes.ListarTodasAsync(_aplicado ?? Filtro(), _pagina + 1);
            _pagina++;
            _fichas.AddRange(p.Itens.Select(i => i with { PodeAbrir = true }));
            _temMais = p.TemMais;
        }
        catch (Exception) { _erro = "Não foi possível carregar mais fichas. Tente outra vez."; }
        finally { _ocupado = false; }
    }
}
