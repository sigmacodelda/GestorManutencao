@inject IPecasService Pecas

@* Escolha da peça e do lugar na ficha, por qualquer ordem (peça e depois local, ou local e depois peça).
   A pesquisa de peça vive fora de qualquer <form> (o Enter tem de pesquisar, nunca gravar o material) e cada instância
   precisa do seu IdCampo. PDA: campo escondido à escuta; sem PDA: botão "Picar com a câmara". O EstadoPicagem é a fonte única. *@
<div class="peca-lugar" id="@(IdCampo + "-bloco")">
    <LeitorEtiquetas @ref="_leitor" Id="@(IdCampo + "-leitor")" OnLido="LerAsync" TextoCamara="Picar com a câmara" SemBotao="SemBotaoCamara" />
    <p class="campo-erro" role="alert">@_erro</p>

    @if (_estado.Peca is null || _peca is null)
    {
        <PecaPesquisa @ref="_pesquisa" SemLeitor="true" IdCampo="@IdCampo" OnEscolher="EscolherAsync" />
    }
    else
    {
        <div class="intervencao">
            <span class="intervencao-titulo">@_peca.Ref @_peca.Design</span>
            @if (!LugarDestino)
            {
                <span class="intervencao-desc">Stock disponível @_peca.QuantidadeDisponivel.ToString("0.###")@(_peca.QuantidadeDisponivel != _peca.Stock ? $" (stock {_peca.Stock:0.###})" : "")</span>
            }
            <button type="button" class="btn-texto" @onclick="LimparPeca"><Icone Nome="x" /><span>Mudar de peça</span></button>
        </div>
    }

    @if (_estado.Local is { } local)
    {
        <div class="intervencao">
            <span class="intervencao-titulo">Lugar @LogicaFichaPeca.TextoLugar(local)</span>
            <button type="button" class="btn-texto" @onclick="LimparLocal"><Icone Nome="x" /><span>Mudar de lugar</span></button>
        </div>
    }
    else if (_lugares.Count > 0)
    {
        @* Peça em vários lugares: escolha obrigatória do lugar de onde saiu (um só lugar escolhe-se sozinho). *@
        <ModalEscolha IdBase="@(IdCampo + "-lugares")" Titulo="@(_peca is null ? "Em que lugar está?" : $"De que lugar saiu {_peca.Design}?")" TextoDescartar="Descartar leitura" Descartar="LimparPeca">
            <ul class="lista-intervencoes">
                @foreach (var l in _lugares)
                {
                    <li>
                        <button type="button" class="intervencao" @onclick="() => EscolherLugarAsync(l)">
                            <span class="intervencao-titulo">@l.Texto</span>
                            <span class="intervencao-desc">@LogicaPicagem.TextoQuantidade(l.Qtt) unidades</span>
                        </button>
                    </li>
                }
            </ul>
        </ModalEscolha>
    }
    @if (_pecasLugar.Count > 0 || _linhas.Count > 0)
    {
        @* Etiqueta de lugar picada sem peça: escolha obrigatória do artigo. Primeiro o material que a ficha já tem
           (peças por dar: "É este" dá a saída deste lugar), depois as peças que o lugar tem (uma só escolhe-se sozinha sem material). *@
        <ModalEscolha IdBase="@(IdCampo + "-pecas")" Titulo="@($"Que artigo é em {LogicaFichaPeca.TextoLugar(_estado.Local)}?")" TextoDescartar="Descartar leitura" Descartar="DescartarLugarAsync">
            @if (_linhas.Count > 0)
            {
                <p class="campo-aviso" role="status">Material já na intervenção</p>
                <ul class="lista-intervencoes">
                    @foreach (var m in _linhas)
                    {
                        <li>
                            <button type="button" class="intervencao" @onclick="() => EscolherLinhaAsync(m)">
                                <span class="intervencao-titulo">É este: @m.Design</span>
                                <span class="intervencao-desc">Peça @m.Ref · @LogicaPicagem.TextoQuantidade(m.Qtt) unidades</span>
                            </button>
                        </li>
                    }
                </ul>
            }
            <ul class="lista-intervencoes">
                @foreach (var x in _pecasLugar)
                {
                    <li>
                        <button type="button" class="intervencao" @onclick="() => EscolherPecaDoLugarAsync(x)">
                            <span class="intervencao-titulo">@x.Ref @x.Design</span>
                            <span class="intervencao-desc">@LogicaPicagem.TextoQuantidade(x.Qtt) unidades neste lugar</span>
                        </button>
                    </li>
                }
            </ul>
        </ModalEscolha>
    }
    @if (_estado.Completo && !LugarDestino)
    {
        <p class="estado-lista" role="status">Peça e lugar escolhidos. Indique a quantidade.</p>
    }
</div>

@code {
    // Notificado a cada mudança; o ecrã preenche o nome e o preço e avança para a quantidade.
    [Parameter] public EventCallback<EscolhaPecaLugar> OnMudou { get; set; }
    [Parameter] public string IdCampo { get; set; } = "ficha-peca";
    // O ecrã põe o botão da câmara numa barra fixa e chama PicarComCameraAsync.
    [Parameter] public bool SemBotaoCamara { get; set; }
    // Edição de um material que já tem peça: picar só o lugar corrige o lugar, sem perguntar pela peça.
    [Parameter] public bool PecaJaLigada { get; set; }
    // Arrumação: o lugar é o destino da peça, não aquele de onde saiu. Não se deriva lugar da peça nem se propõem
    // peças ao picar um lugar; só se guardam a peça e o lugar picados.
    [Parameter] public bool LugarDestino { get; set; }

    // Atalho da página (lugar da lista da peça).
    public async Task DefinirLugarAsync(Lugar l) => await EscolherLugarAsync(l);
    // Material que a ficha já tem: ao picar só o lugar, as peças por dar são candidatas ("É este").
    [Parameter] public IReadOnlyList<Material> MaterialDaFicha { get; set; } = [];
    [Parameter] public EventCallback<(Material Linha, string Local)> OnLinhaEscolhida { get; set; }
    private IReadOnlyList<Material> _linhas = [];

    private async Task EscolherLinhaAsync(Material m)
    {
        string local;
        await _fila.WaitAsync();
        try
        {
            local = _estado.Local ?? "";
            _linhas = [];
            _pecasLugar = [];
            _sel = _sel.LimparLocal();
        }
        finally { _fila.Release(); }
        await OnLinhaEscolhida.InvokeAsync((m, local));
        await NotificarAsync(refocar: true);
    }

    public Task PicarComCameraAsync() => _leitor?.PicarComCameraAsync() ?? Task.CompletedTask;

    // Peça e lugar com a origem do lugar (picado à mão ou derivado da peça): ao mudar de peça só sai o derivado.
    private SelecaoPecaLugar _sel = SelecaoPecaLugar.Vazia;
    private EstadoPicagem _estado => _sel.Estado;
    private Peca? _peca;
    private LocalizacoesPeca? _lug;
    // Lugares com stock para escolher: os da peça, ou os que a API devolveu em 409 escolha_o_lugar.
    private IReadOnlyList<Lugar> _lugares = [];
    // Peças do lugar picado quando ainda não há peça (mais de uma: escolha obrigatória).
    private IReadOnlyList<PecaNoLugar> _pecasLugar = [];
    private string _erro = "";
    private LeitorEtiquetas? _leitor;
    private PecaPesquisa? _pesquisa;
    // Leituras seguidas (PDA) e a gravação do ecrã esperam umas pelas outras: uma picada que chegue durante a gravação
    // aplica-se depois da limpeza em vez de ser apagada por ela.
    private readonly SemaphoreSlim _fila = new(1, 1);

    public EscolhaPecaLugar Atual => new(_estado, _peca, _lug);

    // Corre a gravação dentro da fila das leituras. Devolve true se gravou (e a escolha foi limpa dentro da fila).
    // As exceções da gravação seguem para quem chamou (depois de largar a fila).
    public async Task<bool> GravarAsync(Func<EscolhaPecaLugar, Task<bool>> gravar)
    {
        await _fila.WaitAsync();
        var gravou = false;
        try
        {
            gravou = await gravar(Atual);
            if (gravou) LimparInterno();
        }
        finally { _fila.Release(); }
        if (gravou) await NotificarAsync(refocar: true);
        return gravou;
    }

    // 409 escolha_o_lugar: mostra os lugares que a API devolveu.
    public async Task ProporLugaresAsync(IReadOnlyList<Lugar> lugares)
    {
        await _fila.WaitAsync();
        try
        {
            _lugares = lugares;
            _sel = _sel.LimparLocal();
        }
        finally { _fila.Release(); }
        StateHasChanged();
        await NotificarAsync();
    }

    public async Task LimparAsync()
    {
        await _fila.WaitAsync();
        try { LimparInterno(); }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    private void LimparInterno()
    {
        _sel = SelecaoPecaLugar.Vazia;
        _peca = null;
        _lug = null;
        _lugares = [];
        _pecasLugar = [];
        _linhas = [];
        _erro = "";
    }

    private async Task LerAsync(string codigo)
    {
        await _fila.WaitAsync();
        try
        {
            _erro = "";
            _pecasLugar = [];
            _linhas = [];
            if (LogicaPicagem.Classificar(codigo) == TipoLeitura.Local)
            {
                _sel = _sel.PicarLocal(codigo);
                // Sem peça escolhida: o lugar diz que peça é (uma só escolhe-se; várias, a pessoa decide num modal).
                if (_estado.Peca is null && !PecaJaLigada && !LugarDestino) await ProporPecasDoLugarAsync(codigo);
            }
            else
            {
                try
                {
                    if (await Pecas.ObterPorCodigoAsync(codigo) is { } p) await CarregarPecaAsync(p);
                    else _erro = LogicaEcraPecas.MensagemSemResultado(codigo);
                }
                catch (Exception e) { _erro = MensagensGestao.Para(e, "Não foi possível ler a peça. Tente outra vez."); }
            }
        }
        finally { _fila.Release(); }
        StateHasChanged();
        await NotificarAsync();
    }

    // Dentro da fila. Sem rede ou sem a tabela, o lugar fica picado e a pessoa continua pela pesquisa.
    private async Task ProporPecasDoLugarAsync(string local)
    {
        try
        {
            _linhas = LogicaFichaPeca.CandidatosDoLugar(MaterialDaFicha);
            var pecas = await Pecas.PecasNoLugarAsync(local);
            if (_linhas.Count > 0) _pecasLugar = pecas;
            else if (pecas.Count == 1)
            {
                if (await Pecas.ObterPorCodigoAsync(pecas[0].Ref) is { } unica) await CarregarPecaAsync(unica);
                else _erro = LogicaEcraPecas.MensagemSemResultado(pecas[0].Ref);
            }
            else if (pecas.Count > 1) _pecasLugar = pecas;
            else _erro = "Não há peças com quantidade neste lugar. Pesquise a peça.";
        }
        catch (Exception e) { _erro = MensagensGestao.Para(e, "Não foi possível ver as peças deste lugar. Pesquise a peça."); }
    }

    private async Task EscolherPecaDoLugarAsync(PecaNoLugar escolhida)
    {
        await _fila.WaitAsync();
        try
        {
            _erro = "";
            // O modal só fecha com a peça carregada: se a rede falhar, a pessoa pode tentar outra vez.
            if (await Pecas.ObterPorCodigoAsync(escolhida.Ref) is { } p) { _pecasLugar = []; await CarregarPecaAsync(p); }
            else { _pecasLugar = []; _erro = LogicaEcraPecas.MensagemSemResultado(escolhida.Ref); }
        }
        catch (Exception e) { _erro = MensagensGestao.Para(e, "Não foi possível ler a peça. Tente outra vez."); }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    // Descartar a leitura do lugar: sem a peça não há com que ficar.
    private async Task DescartarLugarAsync()
    {
        await _fila.WaitAsync();
        try
        {
            _pecasLugar = [];
            _linhas = [];
            _sel = _sel.LimparLocal();
        }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    private async Task EscolherAsync(Peca p)
    {
        await _fila.WaitAsync();
        try
        {
            _erro = "";
            await CarregarPecaAsync(p);
        }
        finally { _fila.Release(); }
        await NotificarAsync();
    }

    // Sem os lugares (rede em baixo) a peça escolhe-se na mesma: o servidor pede o lugar se for preciso.
    private async Task CarregarPecaAsync(Peca p)
    {
        LocalizacoesPeca? lug = null;
        try { lug = await Pecas.LugaresAsync(p.Ref); }
        catch (Exception) { _erro = "Não foi possível ver os lugares da peça. Pode juntar na mesma: pede-se o lugar se for preciso."; }
        _peca = p;
        _lug = lug;
        _sel = LugarDestino ? new SelecaoPecaLugar(_sel.Estado with { Peca = p.Ref }, _sel.Origem) : _sel.EscolherPeca(p.Ref, lug);
        _lugares = LugarDestino ? [] : LogicaFichaPeca.ComStock(lug);
        // Um único lugar já ficou escolhido: não há lista para mostrar.
        if (_lugares.Count <= 1) _lugares = [];
    }

    private async Task EscolherLugarAsync(Lugar l)
    {
        await _fila.WaitAsync();
        try { _sel = _sel.EscolherLugar(l); }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    private async Task LimparPeca()
    {
        await _fila.WaitAsync();
        try
        {
            _peca = null;
            _lug = null;
            _sel = _sel.LimparPeca();
            _lugares = [];
        }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    private async Task LimparLocal()
    {
        await _fila.WaitAsync();
        try
        {
            _sel = _sel.LimparLocal();
            _pecasLugar = [];
            // Voltar a escolher: se a peça tem vários lugares a lista reaparece.
            if (!LugarDestino && _lug is not null && LogicaFichaPeca.ComStock(_lug).Count > 1) _lugares = LogicaFichaPeca.ComStock(_lug);
        }
        finally { _fila.Release(); }
        await NotificarAsync(refocar: true);
    }

    private async Task NotificarAsync(bool refocar = false)
    {
        await OnMudou.InvokeAsync(Atual);
        if (!refocar) return;
        // Em modo Leitor o foco volta ao campo escondido (sem teclado virtual); senão à pesquisa. Falha de foco nunca é erro.
        StateHasChanged();
        await Task.Yield();
        if (_leitor is not null) await _leitor.FocarAsync();
        if (_pesquisa is not null) await _pesquisa.FocarAsync();
    }
}
