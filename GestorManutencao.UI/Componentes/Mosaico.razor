@if (Href is null)
{
    <li class="mosaico" aria-disabled="true">
        <span class="mosaico-icone"><Icone Nome="@Icone" /></span>
        <span class="mosaico-texto">
            <span class="mosaico-titulo">@Titulo</span>
            <span class="mosaico-desc">@Descricao</span>
        </span>
        <span class="etiqueta">Em breve</span>
    </li>
}
else
{
    <li>
        <a class="mosaico mosaico-link" href="@Href">
            <span class="mosaico-icone"><Icone Nome="@Icone" /></span>
            <span class="mosaico-texto">
                <span class="mosaico-titulo">@Titulo</span>
                <span class="mosaico-desc">@Descricao</span>
            </span>
        </a>
    </li>
}

@code {
    [Parameter, EditorRequired] public string Icone { get; set; } = "";
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string Descricao { get; set; } = "";
    [Parameter] public string? Href { get; set; }
}
