<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A API do IIS usa um certificado interno: confia-se só nele e só para este endereço. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.1.71</domain>
        <domain includeSubdomains="false">192.168.18.168</domain>
        <trust-anchors>
            <certificates src="@raw/gestor" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
